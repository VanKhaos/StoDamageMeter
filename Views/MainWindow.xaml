<Window x:Class="StoDamageMeter.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:StoDamageMeter.ViewModels"
    xmlns:components="clr-namespace:StoDamageMeter.Components"
    xmlns:converters="clr-namespace:StoDamageMeter.Converters"
    Title="STO Damage Meter"
    Height="800" Width="1400"
    WindowStartupLocation="CenterScreen"
    MinHeight="600" MinWidth="1000"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize">

    <Window.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
    </Window.Resources>

    <!-- Main Container with Modern Design -->
    <Border Background="{StaticResource DarkBackground}"
        CornerRadius="6"
        BorderBrush="{StaticResource CardBorder}"
        BorderThickness="1"
        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0"
                Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                        Background="{StaticResource DarkBackground}"
                        Padding="24,22">
                        <TextBlock Text="STO Damage Meter"
                            Style="{StaticResource ModernSubtitle}"
                            VerticalAlignment="Center" />
                    </Border>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="1" Margin="0,20,0,0">
                        <Button Name="DashboardButton"
                            Tag="Dashboard"
                            Style="{StaticResource NavigationButtonStyle}"
                            Margin="8,4">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24"
                                    Foreground="{StaticResource TextSecondary}"
                                    Width="20" Height="20"
                                    Margin="0,0,12,0" />
                                <TextBlock Text="Dashboard"
                                    Style="{StaticResource ModernText}" />
                            </StackPanel>
                        </Button>

                        <Button Name="LiveTrackingButton"
                            Tag="LiveTracking"
                            Style="{StaticResource NavigationButtonStyle}"
                            Margin="8,4">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataUsage24"
                                    Foreground="{StaticResource TextSecondary}"
                                    Width="20" Height="20"
                                    Margin="0,0,12,0" />
                                <TextBlock Text="Live Tracking"
                                    Style="{StaticResource ModernText}" />
                            </StackPanel>
                        </Button>

                        <Button Name="StatisticsButton"
                            Tag="Statistics"
                            Style="{StaticResource NavigationButtonStyle}"
                            Margin="8,4">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ChartMultiple24"
                                    Foreground="{StaticResource TextSecondary}"
                                    Width="20" Height="20"
                                    Margin="0,0,12,0" />
                                <TextBlock Text="Statistics"
                                    Style="{StaticResource ModernText}" />
                            </StackPanel>
                        </Button>

                        <Button Name="ConfigurationButton"
                            Tag="Configuration"
                            Style="{StaticResource NavigationButtonStyle}"
                            Margin="8,4">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24"
                                    Foreground="{StaticResource TextSecondary}"
                                    Width="20" Height="20"
                                    Margin="0,0,12,0" />
                                <TextBlock Text="Configuration"
                                    Style="{StaticResource ModernText}" />
                            </StackPanel>
                        </Button>

                        <Button Name="AboutButton"
                            Tag="About"
                            Style="{StaticResource NavigationButtonStyle}"
                            Margin="8,4">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Info24"
                                    Foreground="{StaticResource TextSecondary}"
                                    Width="20" Height="20"
                                    Margin="0,0,12,0" />
                                <TextBlock Text="About"
                                    Style="{StaticResource ModernText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Background="{StaticResource DarkBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Bar with Window Controls -->
                <Border Grid.Row="0"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource CardBorder}"
                    Padding="24,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Page Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{Binding Navigation.CurrentPageIcon}"
                                Foreground="{StaticResource PrimaryBlue}"
                                Width="24" Height="24"
                                Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Navigation.CurrentPageTitle}"
                                Style="{StaticResource ModernSubtitle}"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Window Controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Name="MinimizeButton"
                                Click="MinimizeButton_Click"
                                Style="{StaticResource WindowControlButtonStyle}"
                                Margin="0,0,8,0">
                                <ui:SymbolIcon Symbol="Subtract24"
                                    Foreground="{StaticResource TextSecondary}"
                                    Width="16" Height="16" />
                            </Button>

                            <Button Name="CloseButton"
                                Click="CloseButton_Click"
                                Style="{StaticResource WindowControlButtonStyle}">
                                <ui:SymbolIcon Symbol="Dismiss24"
                                    Foreground="{StaticResource TextSecondary}"
                                    Width="16" Height="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content Frame -->
                <Frame Grid.Row="1"
                    Name="ContentFrame"
                    NavigationUIVisibility="Hidden"
                    Background="Transparent" />
            </Grid>
        </Grid>
    </Border>
</Window>