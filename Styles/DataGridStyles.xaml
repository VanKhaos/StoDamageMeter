<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataGrid Haupt-Style -->
    <Style x:Key="DataGridStyle" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserResizeColumns" Value="False" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="IsReadOnly" Value="True" />
    </Style>

    <!-- DataGrid Style-Varianten -->
    <Style x:Key="DataGridCompactStyle" TargetType="{x:Type DataGrid}"
        BasedOn="{StaticResource DataGridStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="RowHeight" Value="28" />
    </Style>

    <Style x:Key="DataGridDetailedStyle" TargetType="{x:Type DataGrid}"
        BasedOn="{StaticResource DataGridStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="RowHeight" Value="36" />
        <Setter Property="GridLinesVisibility" Value="All" />
    </Style>

    <Style x:Key="DataGridMinimalStyle" TargetType="{x:Type DataGrid}"
        BasedOn="{StaticResource DataGridStyle}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="RowHeight" Value="24" />
        <Setter Property="GridLinesVisibility" Value="None" />
    </Style>

    <Style x:Key="DataGridDarkStyle" TargetType="{x:Type DataGrid}"
        BasedOn="{StaticResource DataGridStyle}">
        <Setter Property="Background" Value="#1E1E1E" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="AlternatingRowBackground" Value="#2D2D2D" />
    </Style>

    <Style x:Key="DataGridLightStyle" TargetType="{x:Type DataGrid}"
        BasedOn="{StaticResource DataGridStyle}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="AlternatingRowBackground" Value="#F5F5F5" />
    </Style>

    <Style x:Key="DataGridAccentStyle" TargetType="{x:Type DataGrid}"
        BasedOn="{StaticResource DataGridStyle}">
        <Setter Property="Background" Value="#F8F9FA" />
        <Setter Property="AlternatingRowBackground" Value="#E3F2FD" />
    </Style>

    <!-- Card Style-Varianten für GenericDataGrid -->
    <Style x:Key="StarfleetCardCompactStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource StarfleetDarkBlue}" />
        <Setter Property="BorderBrush" Value="{StaticResource StarfleetGold}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="StarfleetCardDetailedStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource StarfleetDarkBlue}" />
        <Setter Property="BorderBrush" Value="{StaticResource StarfleetGold}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="4" BlurRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StarfleetCardMinimalStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="StarfleetCardDarkStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#0D1117" />
        <Setter Property="BorderBrush" Value="#30363D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="StarfleetCardLightStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#E1E4E8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="StarfleetCardAccentStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#F6F8FA" />
        <Setter Property="BorderBrush" Value="{StaticResource StarfleetGold}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource StarfleetGold}" Opacity="0.2"
                    ShadowDepth="2" BlurRadius="6" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid Spalten-Styles für bessere Wartbarkeit -->
    <Style x:Key="DataGridNumericStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="DataGridNameStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource StarfleetGold}" />
    </Style>

    <Style x:Key="DataGridDPStyle" TargetType="TextBlock"
        BasedOn="{StaticResource DataGridNumericStyle}">
        <Setter Property="Foreground" Value="{StaticResource StarfleetRed}" />
    </Style>

    <Style x:Key="DataGridAverageStyle" TargetType="TextBlock"
        BasedOn="{StaticResource DataGridNumericStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource StarfleetGreen}" />
    </Style>

    <Style x:Key="DataGridTotalStyle" TargetType="TextBlock"
        BasedOn="{StaticResource DataGridNumericStyle}">
        <Setter Property="Foreground" Value="{StaticResource StarfleetGold}" />
    </Style>

    <Style x:Key="DataGridCriticalStyle" TargetType="TextBlock"
        BasedOn="{StaticResource DataGridNumericStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource StarfleetBlue}" />
    </Style>

    <Style x:Key="DataGridUsageStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource StarfleetSilver}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- DataGrid Cell und Header Zentrierung -->
    <Style x:Key="DataGridContentCellCentering" TargetType="{x:Type DataGridCell}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background"
                    Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DataGridHeaderCentering" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DataGridHeaderRightAlign" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DataGridContentCellRightAlign" TargetType="{x:Type DataGridCell}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background"
                    Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DataGrid Row Style ohne Selektion -->
    <Style x:Key="DataGridRowNoSelection" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DataGrid Cell Style ohne Selektion -->
    <Style x:Key="DataGridCellNoSelection" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- BENUTZERDEFINIERTE STYLES - Beispiele -->

    <!-- Gaming-Style für Gaming-Tabellen -->
    <Style x:Key="StarfleetCardGamingStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#0A0A0A" />
        <Setter Property="BorderBrush" Value="#00FF00" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#00FF00" Opacity="0.4" ShadowDepth="3" BlurRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DataGridGamingStyle" TargetType="{x:Type DataGrid}"
        BasedOn="{StaticResource DataGridStyle}">
        <Setter Property="Background" Value="#0A0A0A" />
        <Setter Property="Foreground" Value="#00FF00" />
        <Setter Property="AlternatingRowBackground" Value="#1A1A1A" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Corporate-Style für Business-Tabellen -->
    <Style x:Key="StarfleetCardCorporateStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#2C3E50" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#2C3E50" Opacity="0.1" ShadowDepth="2" BlurRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DataGridCorporateStyle" TargetType="{x:Type DataGrid}"
        BasedOn="{StaticResource DataGridStyle}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#2C3E50" />
        <Setter Property="AlternatingRowBackground" Value="#F8F9FA" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="RowHeight" Value="32" />
    </Style>

    <!-- Retro-Style für Vintage-Look -->
    <Style x:Key="StarfleetCardRetroStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#8B4513" />
        <Setter Property="BorderBrush" Value="#DAA520" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" Opacity="0.5" ShadowDepth="4" BlurRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DataGridRetroStyle" TargetType="{x:Type DataGrid}"
        BasedOn="{StaticResource DataGridStyle}">
        <Setter Property="Background" Value="#8B4513" />
        <Setter Property="Foreground" Value="#DAA520" />
        <Setter Property="AlternatingRowBackground" Value="#A0522D" />
        <Setter Property="FontFamily" Value="Courier New" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="RowHeight" Value="30" />
    </Style>

</ResourceDictionary>