<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:StoDamageMeter.Converters">

    <!-- Star Trek Theme Color Palette -->
    <SolidColorBrush x:Key="Background" Color="#171B20" /> <!-- hsl(220 13% 9%) -->
    <SolidColorBrush x:Key="Foreground" Color="#FAFAFA" /> <!-- hsl(0 0% 98%) -->
    <SolidColorBrush x:Key="Card" Color="#171B20" /> <!-- hsl(220 13% 9%) -->
    <SolidColorBrush x:Key="CardForeground" Color="#FAFAFA" /> <!-- hsl(0 0% 98%) -->
    <SolidColorBrush x:Key="Popover" Color="#171B20" /> <!-- hsl(220 13% 9%) -->
    <SolidColorBrush x:Key="PopoverForeground" Color="#FAFAFA" /> <!-- hsl(0 0% 98%) -->
    <SolidColorBrush x:Key="Primary" Color="#0066CC" /> <!-- hsl(210 100% 40%) -->
    <SolidColorBrush x:Key="PrimaryForeground" Color="#FAFAFA" /> <!-- hsl(0 0% 98%) -->
    <SolidColorBrush x:Key="Secondary" Color="#1F2937" /> <!-- hsl(220 13% 15%) -->
    <SolidColorBrush x:Key="SecondaryForeground" Color="#FAFAFA" /> <!-- hsl(0 0% 98%) -->
    <SolidColorBrush x:Key="Muted" Color="#1F2937" /> <!-- hsl(220 13% 15%) -->
    <SolidColorBrush x:Key="MutedForeground" Color="#A3A3A3" /> <!-- hsl(0 0% 63.9%) -->
    <SolidColorBrush x:Key="Accent" Color="#1F2937" /> <!-- hsl(220 13% 15%) -->
    <SolidColorBrush x:Key="AccentForeground" Color="#FAFAFA" /> <!-- hsl(0 0% 98%) -->
    <SolidColorBrush x:Key="Destructive" Color="#B91C1C" /> <!-- hsl(0 62.8% 30.6%) -->
    <SolidColorBrush x:Key="DestructiveForeground" Color="#FAFAFA" /> <!-- hsl(0 0% 98%) -->
    <SolidColorBrush x:Key="Border" Color="#2A2F3A" /> <!-- hsl(220 13% 18%) -->
    <SolidColorBrush x:Key="Input" Color="#2A2F3A" /> <!-- hsl(220 13% 18%) -->
    <SolidColorBrush x:Key="Ring" Color="#0066CC" /> <!-- hsl(210 100% 40%) -->

    <!-- Star Trek Themed Colors -->
    <SolidColorBrush x:Key="StarfleetBlue" Color="#0066CC" />
    <SolidColorBrush x:Key="StarfleetGold" Color="#FFD700" />
    <SolidColorBrush x:Key="StarfleetSilver" Color="#C0C0C0" />
    <SolidColorBrush x:Key="StarfleetRed" Color="#CC0000" />
    <SolidColorBrush x:Key="StarfleetGreen" Color="#00CC66" />
    <SolidColorBrush x:Key="StarfleetPurple" Color="#6600CC" />
    <SolidColorBrush x:Key="StarfleetDark" Color="#001122" />
    <SolidColorBrush x:Key="StarfleetDarker" Color="#000811" />

    <!-- Legacy Colors (for compatibility) -->
    <SolidColorBrush x:Key="PrimaryBlue" Color="#0066CC" />
    <SolidColorBrush x:Key="PrimaryBlueHover" Color="#0052A3" />
    <SolidColorBrush x:Key="SuccessGreen" Color="#00CC66" />
    <SolidColorBrush x:Key="WarningOrange" Color="#FF8C00" />
    <SolidColorBrush x:Key="ErrorRed" Color="#CC0000" />
    <SolidColorBrush x:Key="DarkBackground" Color="#171B20" />
    <SolidColorBrush x:Key="CardBackground" Color="#1F2937" />
    <SolidColorBrush x:Key="CardBorder" Color="#2A2F3A" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FAFAFA" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A3A3A3" />
    <SolidColorBrush x:Key="TextMuted" Color="#808080" />
    <SolidColorBrush x:Key="AccentBlue" Color="#0066CC" />

    <!-- Star Trek Glow Effect -->
    <DropShadowEffect x:Key="StarfleetGlowEffect"
        Color="#0066CC"
        BlurRadius="10"
        ShadowDepth="0"
        Opacity="0.3" />

    <!-- Converter -->
    <converters:InvertBooleanConverter x:Key="InvertBooleanConverter" />
    <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
    <converters:InvertStringToVisibilityConverter x:Key="InvertStringToVisibilityConverter" />

    <!-- Star Trek Button Styles -->
    <Style x:Key="StarfleetButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Primary}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        BorderThickness="0"
                        Effect="{StaticResource StarfleetGlowEffect}">
                        <ContentPresenter HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#0052A3" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#003D7A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource Muted}" />
                            <Setter Property="Foreground" Value="{StaticResource MutedForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StarfleetButtonOutline" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Foreground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentForeground}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource Muted}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource Muted}" />
                            <Setter Property="Foreground" Value="{StaticResource MutedForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StarfleetButtonSecondary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Secondary}" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryForeground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#374151" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#4B5563" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource Muted}" />
                            <Setter Property="Foreground" Value="{StaticResource MutedForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Legacy Modern Button Style (for compatibility) -->
    <Style x:Key="ModernButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Primary}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#0052A3" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#003D7A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource Muted}" />
                            <Setter Property="Foreground" Value="{StaticResource MutedForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Control Button Style -->
    <Style x:Key="WindowControlButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MutedForeground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Secondary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation Button Style -->
    <Style x:Key="NavigationButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Foreground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Secondary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Star Trek Card Style -->
    <Style x:Key="StarfleetCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Effect" Value="{StaticResource StarfleetGlowEffect}" />
    </Style>

    <!-- Legacy Modern Card Style (for compatibility) -->
    <Style x:Key="ModernCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Effect" Value="{StaticResource StarfleetGlowEffect}" />
    </Style>

    <!-- Star Trek Text Styles -->
    <Style x:Key="StarfleetTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StarfleetGold}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style x:Key="StarfleetSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StarfleetSilver}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="StarfleetText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Foreground}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="StarfleetMutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedForeground}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Legacy Text Styles (for compatibility) -->
    <Style x:Key="ModernTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StarfleetGold}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="ModernSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StarfleetSilver}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="ModernText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Foreground}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="ModernMutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedForeground}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="ModernSecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedForeground}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Toggle Button Styles -->
    <Style x:Key="ToggleButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Foreground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Secondary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource Primary}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ActiveToggleButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Primary}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryForeground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#0052A3" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#003D7A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Starfleet GroupBox Style -->
    <Style x:Key="StarfleetGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Border Grid.Row="0"
                                    Background="{StaticResource StarfleetBlue}"
                                    CornerRadius="4,4,0,0"
                                    Margin="-16,-16,-16,8"
                                    Padding="12,8">
                                    <TextBlock Text="{TemplateBinding Header}"
                                        Foreground="{StaticResource TextPrimary}"
                                        FontWeight="SemiBold"
                                        FontSize="14" />
                                </Border>

                                <!-- Content -->
                                <ContentPresenter Grid.Row="1" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Starfleet CheckBox Style -->
    <Style x:Key="StarfleetCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Check Box -->
                        <Border Grid.Column="0"
                            Width="20"
                            Height="20"
                            Background="{StaticResource Input}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="2"
                            CornerRadius="4"
                            Margin="0,0,8,0">
                            <Path x:Name="CheckMark"
                                Data="M 3,8 L 7,12 L 15,4"
                                Stroke="{StaticResource StarfleetGold}"
                                StrokeThickness="2"
                                Visibility="Collapsed" />
                        </Border>

                        <!-- Content -->
                        <ContentPresenter Grid.Column="1"
                            VerticalAlignment="Center" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter Property="Background" Value="{StaticResource StarfleetBlue}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource StarfleetBlue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>