{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch StoDamageMeter",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net9.0-windows/StoDamageMeter.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "externalTerminal",
      "stopAtEntry": false,
      "justMyCode": true,
      "enableStepFiltering": false,
      "suppressJITOptimizations": true,
      "requireExactSource": false,
      "enableLogging": false,
      "symbolOptions": {
        "searchPaths": [],
        "searchMicrosoftSymbolServer": false,
        "searchNuGetOrgSymbolServer": false
      }
    },
    {
      "name": "Launch StoDamageMeter (Release)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-release",
      "program": "${workspaceFolder}/bin/Release/net9.0-windows/StoDamageMeter.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "externalTerminal",
      "stopAtEntry": false,
      "justMyCode": true,
      "enableStepFiltering": false,
      "suppressJITOptimizations": false,
      "requireExactSource": false,
      "enableLogging": false
    },
    {
      "name": "Attach to StoDamageMeter",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
