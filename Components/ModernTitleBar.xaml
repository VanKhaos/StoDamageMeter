<UserControl x:Class="StoDamageMeter.Components.ModernTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="800">
    
    <Border Background="{StaticResource CardBackground}" 
            CornerRadius="12,12,0,0"
            BorderBrush="{StaticResource CardBorder}"
            BorderThickness="1,1,1,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="24,16">
                <TextBlock Text="Star Trek Online - Damage Meter" 
                           Style="{StaticResource ModernTitle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            
            <!-- Window Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16">
                <Button Content="−" Width="32" Height="28" 
                        Style="{StaticResource WindowControlButton}"
                        Click="MinimizeButton_Click"
                        Margin="0,0,8,0"/>
                <Button Content="✕" Width="32" Height="28" 
                        Style="{StaticResource CloseButton}"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
