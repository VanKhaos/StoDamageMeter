<UserControl x:Class="StoDamageMeter.Components.Shared.LoadingSpinner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ui:CardControl Background="{StaticResource CardBackground}"
        BorderBrush="{StaticResource CardBorder}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="24"
        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Spinner -->
            <Border Width="40" Height="40"
                HorizontalAlignment="Center"
                Margin="0,0,0,16">
                <Border.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotation" CenterX="20" CenterY="20" />
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                    Storyboard.TargetProperty="Angle"
                                    From="0" To="360" Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Ellipse Fill="{StaticResource PrimaryBlue}"
                    Width="8" Height="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top" />
            </Border>

            <!-- Loading Message -->
            <TextBlock Text="{Binding LoadingMessage}"
                Style="{StaticResource ModernText}"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Margin="0,0,0,8" />

            <!-- Loading Time -->
            <TextBlock Text="{Binding LoadingTime}"
                Style="{StaticResource ModernMutedText}"
                FontSize="14"
                HorizontalAlignment="Center" />
        </StackPanel>
    </ui:CardControl>
</UserControl>