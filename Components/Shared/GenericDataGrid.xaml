<UserControl x:Class="StoDamageMeter.Components.Shared.GenericDataGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    xmlns:converters="clr-namespace:StoDamageMeter.Converters"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/DataGridStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:RowIndexConverter x:Key="RowIndexConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="MainBorder" Style="{StaticResource StarfleetCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel x:Name="HeaderPanel" Grid.Row="0" Margin="20,20,20,10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <shared:StarfleetIcon
                        Icon="{Binding HeaderIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Size="20"
                        Color="{StaticResource StarfleetGold}"
                        Margin="0,0,8,0" />
                    <TextBlock
                        Text="{Binding HeaderTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{StaticResource StarfleetGold}" />
                </StackPanel>
                <TextBlock
                    Text="{Binding HeaderSubtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    FontSize="12"
                    Foreground="{StaticResource StarfleetSilver}"
                    Opacity="0.8" />
            </StackPanel>

            <!-- DataGrid -->
            <DataGrid x:Name="DataGrid" Grid.Row="1"
                ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                AutoGenerateColumns="False"
                Style="{StaticResource DataGridStyle}"
                MaxHeight="{Binding MaxHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                MinWidth="{Binding MinWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Loaded="DataGrid_Loaded"
                SelectionChanged="DataGrid_SelectionChanged">

                <DataGrid.Columns>
                    <!-- Dynamische Spalten werden hier eingefügt -->
                </DataGrid.Columns>
            </DataGrid>

            <!-- Keine Daten -->
            <StackPanel Grid.Row="1"
                Visibility="{Binding ItemsSource.Count, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibilityConverter}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <shared:StarfleetIcon Icon="Info" Size="32"
                    Color="{StaticResource StarfleetSilver}" />
                <TextBlock
                    Text="{Binding NoDataMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource StarfleetMutedText}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>