<UserControl x:Class="StoDamageMeter.Components.LiveDamageStatisticsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="400" d:DesignWidth="800">

    <Border Style="{StaticResource ModernCardStyle}">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Ellipse Width="12" Height="12"
                    Fill="{StaticResource SuccessGreen}"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center" />
                <TextBlock Text="Live-Damage-Statistiken"
                    Style="{StaticResource ModernSubtitle}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Echtzeit-Updates der Combatlog-Daten"
                Style="{StaticResource ModernMutedText}"
                Margin="0,0,0,24" />

            <!-- Player Statistics Card -->
            <Border Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,16">
                <StackPanel>
                    <!-- Player Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="10" Height="10"
                                    Fill="{StaticResource SuccessGreen}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{Binding Statistics, StringFormat='Live-Statistiken für {0}'}"
                                    Style="{StaticResource ModernText}"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <Button Content="Wechseln"
                            Background="{StaticResource AccentBlue}"
                            Foreground="{StaticResource TextPrimary}"
                            BorderThickness="0"
                            Padding="16,8"
                            FontWeight="Medium"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        BorderThickness="0">
                                        <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}">
                                            <TextBlock Text="👥" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="{TemplateBinding Content}"
                                                Foreground="{TemplateBinding Foreground}"
                                                FontWeight="{TemplateBinding FontWeight}"
                                                FontSize="{TemplateBinding FontSize}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#0284C7" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Live Damage Statistics Content -->
                    <Border Background="{StaticResource DarkBackground}"
                        BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24"
                        MinHeight="200">
                        <StackPanel>
                            <!-- Content Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <TextBlock Text="Live-Damage-Statistiken"
                                    Style="{StaticResource ModernText}"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />

                                <Button Content="Aktualisieren"
                                    Background="{StaticResource PrimaryBlue}"
                                    Foreground="{StaticResource TextPrimary}"
                                    BorderThickness="0"
                                    Padding="12,6"
                                    FontWeight="Medium"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0"
                                    Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                BorderThickness="0">
                                                <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="{TemplateBinding Padding}">
                                                    <TextBlock Text="🔄" FontSize="10"
                                                        Margin="0,0,4,0" />
                                                    <TextBlock Text="{TemplateBinding Content}"
                                                        Foreground="{TemplateBinding Foreground}"
                                                        FontWeight="{TemplateBinding FontWeight}"
                                                        FontSize="{TemplateBinding FontSize}" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background"
                                                        Value="{StaticResource PrimaryBlueHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- Live Statistics Content -->
                            <Grid>
                                <!-- Empty State -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Statistics, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="📊"
                                        FontSize="48"
                                        HorizontalAlignment="Center"
                                        Foreground="{StaticResource SuccessGreen}"
                                        Margin="0,0,0,16" />

                                    <TextBlock
                                        Text="Live-Events werden hier angezeigt, sobald sie empfangen werden..."
                                        Style="{StaticResource ModernSecondaryText}"
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center"
                                        Margin="0,0,0,12" />

                                    <TextBlock
                                        Text="Tipp: Wähle eine Combatlog-Datei aus um Statistiken zu sehen"
                                        Style="{StaticResource ModernMutedText}"
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center"
                                        FontSize="11" />
                                </StackPanel>

                                <!-- Statistics Content -->
                                <StackPanel
                                    Visibility="{Binding Statistics, Converter={StaticResource NotNullToVisibilityConverter}}">
                                    <!-- Key Metrics -->
                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Total Damage -->
                                        <Border Grid.Column="0"
                                            Background="{StaticResource CardBackground}"
                                            CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="Gesamtschaden"
                                                    Style="{StaticResource ModernMutedText}"
                                                    FontSize="11" Margin="0,0,0,4" />
                                                <TextBlock
                                                    Text="{Binding Statistics.TotalDamage, StringFormat={}{0:N0}}"
                                                    Style="{StaticResource ModernText}"
                                                    FontWeight="Bold" FontSize="18" />
                                            </StackPanel>
                                        </Border>

                                        <!-- DPS -->
                                        <Border Grid.Column="1"
                                            Background="{StaticResource CardBackground}"
                                            CornerRadius="8" Padding="16" Margin="4,0">
                                            <StackPanel>
                                                <TextBlock Text="DPS"
                                                    Style="{StaticResource ModernMutedText}"
                                                    FontSize="11" Margin="0,0,0,4" />
                                                <TextBlock
                                                    Text="{Binding Statistics.DPS, StringFormat={}{0:N0}}"
                                                    Style="{StaticResource ModernText}"
                                                    FontWeight="Bold" FontSize="18" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Critical Rate -->
                                        <Border Grid.Column="2"
                                            Background="{StaticResource CardBackground}"
                                            CornerRadius="8" Padding="16" Margin="4,0">
                                            <StackPanel>
                                                <TextBlock Text="Crit-Rate"
                                                    Style="{StaticResource ModernMutedText}"
                                                    FontSize="11" Margin="0,0,0,4" />
                                                <TextBlock
                                                    Text="{Binding Statistics.CriticalRate, StringFormat={}{0:F1}%}"
                                                    Style="{StaticResource ModernText}"
                                                    FontWeight="Bold" FontSize="18" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Total Hits -->
                                        <Border Grid.Column="3"
                                            Background="{StaticResource CardBackground}"
                                            CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Treffer"
                                                    Style="{StaticResource ModernMutedText}"
                                                    FontSize="11" Margin="0,0,0,4" />
                                                <TextBlock
                                                    Text="{Binding Statistics.RelevantEntries}"
                                                    Style="{StaticResource ModernText}"
                                                    FontWeight="Bold" FontSize="18" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Combat Duration -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="Kampfdauer: "
                                            Style="{StaticResource ModernSecondaryText}" />
                                        <TextBlock
                                            Text="{Binding Statistics.CombatDuration, StringFormat={}{0:hh\\:mm\\:ss}}"
                                            Style="{StaticResource ModernText}"
                                            FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>