<UserControl x:Class="StoDamageMeter.Components.PageSpecific.Statistics.FilterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    xmlns:converters="clr-namespace:StoDamageMeter.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource StarfleetCardStyle}"
        Visibility="{Binding SelectedPlayer, Converter={StaticResource StringToVisibilityConverter}}">
        <StackPanel>
            <!-- Header mit Toggle-Button -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <shared:StarfleetIcon Icon="Filter" Size="20"
                    Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                <TextBlock Text="Filter"
                    Style="{StaticResource StarfleetTitle}" />
                <Button Content="Ein-/Ausblenden"
                    Command="{Binding ToggleFilterPanelCommand}"
                    Style="{StaticResource StarfleetButton}"
                    Margin="16,0,0,0"
                    Padding="12,4"
                    FontSize="12" />
            </StackPanel>

            <!-- Filter-Panel (Collapsible) -->
            <StackPanel
                Visibility="{Binding IsFilterPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                <!-- Zeit-Filter -->
                <GroupBox Header="Zeit-Filter" Margin="0,0,0,16"
                    Style="{StaticResource StarfleetGroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Von:"
                            Style="{StaticResource StarfleetSubtitle}" Margin="0,0,0,8" />
                        <DatePicker Grid.Row="1" Grid.Column="0"
                            SelectedDate="{Binding CurrentFilter.StartTime}"
                            Margin="0,0,8,0"
                            Background="{StaticResource Input}"
                            Foreground="{StaticResource Foreground}"
                            BorderBrush="{StaticResource Border}" />

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Bis:"
                            Style="{StaticResource StarfleetSubtitle}" Margin="0,0,0,8" />
                        <DatePicker Grid.Row="1" Grid.Column="1"
                            SelectedDate="{Binding CurrentFilter.EndTime}"
                            Margin="8,0,0,0"
                            Background="{StaticResource Input}"
                            Foreground="{StaticResource Foreground}"
                            BorderBrush="{StaticResource Border}" />
                    </Grid>
                </GroupBox>

                <!-- Schaden-Filter -->
                <GroupBox Header="Schaden-Filter" Margin="0,0,0,16"
                    Style="{StaticResource StarfleetGroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Min. Schaden:"
                            Style="{StaticResource StarfleetSubtitle}" Margin="0,0,0,8" />
                        <TextBox Grid.Row="1" Grid.Column="0"
                            Text="{Binding CurrentFilter.MinDamage, StringFormat='{}{0:N0}'}"
                            Margin="0,0,8,0"
                            Background="{StaticResource Input}"
                            Foreground="{StaticResource Foreground}"
                            BorderBrush="{StaticResource Border}"
                            Padding="8,4" />

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Max. Schaden:"
                            Style="{StaticResource StarfleetSubtitle}" Margin="0,0,0,8" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                            Text="{Binding CurrentFilter.MaxDamage, StringFormat='{}{0:N0}'}"
                            Margin="8,0,0,0"
                            Background="{StaticResource Input}"
                            Foreground="{StaticResource Foreground}"
                            BorderBrush="{StaticResource Border}"
                            Padding="8,4" />
                    </Grid>
                </GroupBox>

                <!-- Companion-Filter -->
                <GroupBox Header="Schaden-Typ" Margin="0,0,0,16"
                    Style="{StaticResource StarfleetGroupBoxStyle}">
                    <StackPanel>
                        <CheckBox Content="Companion-Schaden einschließen"
                            IsChecked="{Binding CurrentFilter.IncludeCompanionDamage}"
                            Style="{StaticResource StarfleetCheckBox}"
                            Margin="0,0,0,8" />
                        <CheckBox Content="Direkter Spieler-Schaden einschließen"
                            IsChecked="{Binding CurrentFilter.IncludeDirectPlayerDamage}"
                            Style="{StaticResource StarfleetCheckBox}" />
                    </StackPanel>
                </GroupBox>

                <!-- Filter-Presets -->
                <GroupBox Header="Schnellfilter" Margin="0,0,0,16"
                    Style="{StaticResource StarfleetGroupBoxStyle}">
                    <WrapPanel>
                        <Button Content="Hoher Schaden (1000+)"
                            Command="{Binding ApplyFilterPresetCommand}"
                            CommandParameter="HighDamage"
                            Style="{StaticResource StarfleetButton}"
                            Margin="0,0,8,8"
                            Padding="12,6" />
                        <Button Content="Kritische Treffer (500+)"
                            Command="{Binding ApplyFilterPresetCommand}"
                            CommandParameter="CriticalHits"
                            Style="{StaticResource StarfleetButton}"
                            Margin="0,0,8,8"
                            Padding="12,6" />
                        <Button Content="Top 5 Waffen"
                            Command="{Binding ApplyFilterPresetCommand}"
                            CommandParameter="TopWeapons"
                            Style="{StaticResource StarfleetButton}"
                            Margin="0,0,8,8"
                            Padding="12,6" />
                    </WrapPanel>
                </GroupBox>

                <!-- Filter-Aktionen -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Filter zurücksetzen"
                        Command="{Binding ResetFiltersCommand}"
                        Style="{StaticResource StarfleetButton}"
                        Margin="0,0,8,0"
                        Padding="16,8" />
                    <Button Content="Filter anwenden"
                        Command="{Binding ApplyFiltersCommand}"
                        Style="{StaticResource StarfleetButton}"
                        Background="{StaticResource StarfleetGold}"
                        Foreground="{StaticResource StarfleetDark}"
                        Padding="16,8" />
                </StackPanel>

                <!-- Filter-Status -->
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                    Visibility="{Binding CurrentFilter.IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <shared:StarfleetIcon Icon="Info" Size="16"
                        Color="{StaticResource StarfleetBlue}" Margin="0,0,8,0" />
                    <TextBlock Text="Filter aktiv"
                        Style="{StaticResource StarfleetMutedText}"
                        Foreground="{StaticResource StarfleetBlue}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>