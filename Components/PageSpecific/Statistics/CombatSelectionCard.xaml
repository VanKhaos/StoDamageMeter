<UserControl x:Class="StoDamageMeter.Components.PageSpecific.Statistics.CombatSelectionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    xmlns:converters="clr-namespace:StoDamageMeter.Converters">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </UserControl.Resources>

    <Border Style="{StaticResource StarfleetCardStyle}"
        Visibility="{Binding SelectedPlayer, Converter={StaticResource StringToVisibilityConverter}}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <shared:StarfleetIcon Icon="Sword" Size="20"
                    Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                <TextBlock Text="Kampf-Auswahl"
                    Style="{StaticResource StarfleetTitle}" />
            </StackPanel>

            <!-- Kampf-Buttons -->
            <ItemsControl ItemsSource="{Binding CombatPeriods}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Content="{Binding StartTime, StringFormat='{}{0:dd.MM.yyyy | HH:mm}'}"
                            Command="{Binding DataContext.SelectPeriodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Margin="0,0,8,8"
                            Padding="16,8"
                            MinWidth="140">
                            <Button.Style>
                                <Style TargetType="Button"
                                    BasedOn="{StaticResource StarfleetButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}"
                                            Value="True">
                                            <Setter Property="Background"
                                                Value="{StaticResource StarfleetGold}" />
                                            <Setter Property="Foreground"
                                                Value="{StaticResource StarfleetDark}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Keine Kämpfe -->
            <StackPanel HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Visibility="{Binding CombatPeriods.Count, Converter={StaticResource NullToVisibilityConverter}}">
                <shared:StarfleetIcon Icon="Info" Size="32"
                    Color="{StaticResource StarfleetSilver}" />
                <TextBlock Text="Keine Kämpfe verfügbar"
                    Style="{StaticResource StarfleetMutedText}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>