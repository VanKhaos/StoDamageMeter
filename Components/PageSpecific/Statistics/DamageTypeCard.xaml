<UserControl x:Class="StoDamageMeter.Components.PageSpecific.Statistics.DamageTypeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    xmlns:converters="clr-namespace:StoDamageMeter.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:RowIndexConverter x:Key="RowIndexConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource StarfleetCardStyle}">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <shared:StarfleetIcon Icon="BarChart" Size="20"
                    Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                <TextBlock Text="Schadensarten-Verteilung"
                    Style="{StaticResource StarfleetTitle}" />
            </StackPanel>

            <!-- Schadensarten Tabelle -->
            <DataGrid
                ItemsSource="{Binding DamageTypeStatistics}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="False"
                CanUserSortColumns="True"
                IsReadOnly="True"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                AlternatingRowBackground="Transparent"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                RowHeaderWidth="0"
                MaxHeight="400"
                MinWidth="900">

                <DataGrid.Columns>
                    <!-- # Reihenfolge -->
                    <DataGridTemplateColumn Header="#" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <shared:StarfleetBadge
                                    Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource RowIndexConverter}}"
                                    Variant="Outline" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Schadensart -->
                    <DataGridTextColumn Header="Schadensart"
                        Binding="{Binding DamageType}"
                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{StaticResource StarfleetGold}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- DPS -->
                    <DataGridTextColumn Header="DPS"
                        Binding="{Binding DPS, StringFormat='{}{0:N0}'}"
                        Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="{StaticResource StarfleetRed}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Durchschnittsschaden -->
                    <DataGridTextColumn Header="Ø Schaden"
                        Binding="{Binding FormattedAverageDamage}"
                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground"
                                    Value="{StaticResource StarfleetGreen}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Gesamtschaden -->
                    <DataGridTextColumn Header="Gesamtschaden"
                        Binding="{Binding FormattedTotalDamage}"
                        Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="{StaticResource StarfleetGold}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>


                    <!-- Kritische Treffer -->
                    <DataGridTextColumn Header="Krit. Treffer"
                        Binding="{Binding CriticalHits}"
                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{StaticResource StarfleetRed}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Kritische Rate -->
                    <DataGridTextColumn Header="Krit. Rate"
                        Binding="{Binding FormattedCriticalRate}"
                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{StaticResource StarfleetBlue}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Anteil -->
                    <DataGridTemplateColumn Header="Anteil" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <shared:StarfleetProgressBar
                                        Value="{Binding DamageShare}"
                                        Text="{Binding FormattedDamageShare}"
                                        Height="16" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Keine Daten -->
            <StackPanel
                Visibility="{Binding DamageTypeStatistics.Count, Converter={StaticResource NullToVisibilityConverter}}"
                HorizontalAlignment="Center"
                Margin="0,20,0,0">
                <shared:StarfleetIcon Icon="Info" Size="32"
                    Color="{StaticResource StarfleetSilver}" />
                <TextBlock Text="Keine Schadensarten-Daten verfügbar"
                    Style="{StaticResource StarfleetMutedText}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>