<UserControl x:Class="StoDamageMeter.Components.PageSpecific.Statistics.DamageTypeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    xmlns:models="clr-namespace:StoDamageMeter.Models">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <shared:GenericDataGrid
        x:Name="DamageTypeDataGrid"
        ItemsSource="{Binding DamageTypeStatistics}"
        HeaderTitle="Schadensarten-Verteilung"
        HeaderSubtitle="Detaillierte Aufschlüsselung aller Schadensarten"
        HeaderIcon="BarChart"
        DefaultSortPropertyName="TotalDamage"
        DefaultSortDirection="Descending"
        MaxHeight="400"
        MinWidth="900"
        NoDataMessage="Keine Schadensarten-Daten verfügbar"
        StyleVariant="Default"
        HeaderStyleVariant="Default"
        SelectionChanged="GenericDataGrid_SelectionChanged" />
</UserControl>