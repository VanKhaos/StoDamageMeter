<UserControl x:Class="StoDamageMeter.Components.PageSpecific.Statistics.PlayerSummaryCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    xmlns:converters="clr-namespace:StoDamageMeter.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource StarfleetCardStyle}"
        Visibility="{Binding PlayerSummary, Converter={StaticResource NullToVisibilityConverter}}">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <shared:StarfleetIcon Icon="User" Size="20"
                    Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                <TextBlock
                    Text="{Binding PlayerSummary.PlayerName, StringFormat='Kampfstatistiken: {0}'}"
                    Style="{StaticResource StarfleetTitle}" />
            </StackPanel>

            <!-- Hauptstatistiken Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Gesamtschaden -->
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,16,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <shared:StarfleetIcon Icon="Sword" Size="16"
                            Color="{StaticResource StarfleetSilver}" Margin="0,0,6,0" />
                        <TextBlock Text="Gesamtschaden"
                            Style="{StaticResource StarfleetMutedText}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PlayerSummary.FormattedTotalDamage}"
                        Style="{StaticResource StarfleetText}"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{StaticResource StarfleetGold}" />
                </StackPanel>

                <!-- DPS -->
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="8,0,8,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <shared:StarfleetIcon Icon="Chart" Size="16"
                            Color="{StaticResource StarfleetSilver}" Margin="0,0,6,0" />
                        <TextBlock Text="DPS"
                            Style="{StaticResource StarfleetMutedText}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PlayerSummary.FormattedDPS}"
                        Style="{StaticResource StarfleetText}"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{StaticResource StarfleetRed}" />
                </StackPanel>

                <!-- Kritische Rate -->
                <StackPanel Grid.Column="2" Grid.Row="0" Margin="8,0,8,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <shared:StarfleetIcon Icon="Star" Size="16"
                            Color="{StaticResource StarfleetSilver}" Margin="0,0,6,0" />
                        <TextBlock Text="Krit. Rate"
                            Style="{StaticResource StarfleetMutedText}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PlayerSummary.FormattedCriticalRate}"
                        Style="{StaticResource StarfleetText}"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{StaticResource StarfleetBlue}" />
                </StackPanel>

                <!-- Durchschnittsschaden -->
                <StackPanel Grid.Column="3" Grid.Row="0" Margin="16,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <shared:StarfleetIcon Icon="BarChart" Size="16"
                            Color="{StaticResource StarfleetSilver}" Margin="0,0,6,0" />
                        <TextBlock Text="Ø Schaden"
                            Style="{StaticResource StarfleetMutedText}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PlayerSummary.FormattedAverageDamage}"
                        Style="{StaticResource StarfleetText}"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{StaticResource StarfleetGreen}" />
                </StackPanel>

                <!-- Kampfdauer -->
                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <shared:StarfleetIcon Icon="Clock" Size="16"
                            Color="{StaticResource StarfleetSilver}" Margin="0,0,6,0" />
                        <TextBlock Text="Kampfdauer"
                            Style="{StaticResource StarfleetMutedText}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PlayerSummary.FormattedDuration}"
                        Style="{StaticResource StarfleetText}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource StarfleetSilver}" />
                </StackPanel>

                <!-- Treffer -->
                <StackPanel Grid.Column="1" Grid.Row="1" Margin="8,0,8,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <shared:StarfleetIcon Icon="Star" Size="16"
                            Color="{StaticResource StarfleetSilver}" Margin="0,0,6,0" />
                        <TextBlock Text="Treffer"
                            Style="{StaticResource StarfleetMutedText}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PlayerSummary.TotalHits}"
                        Style="{StaticResource StarfleetText}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource StarfleetSilver}" />
                </StackPanel>

                <!-- Kritische Treffer -->
                <StackPanel Grid.Column="2" Grid.Row="1" Margin="8,0,8,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <shared:StarfleetIcon Icon="Star" Size="16"
                            Color="{StaticResource StarfleetSilver}" Margin="0,0,6,0" />
                        <TextBlock Text="Krit. Treffer"
                            Style="{StaticResource StarfleetMutedText}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PlayerSummary.CriticalHits}"
                        Style="{StaticResource StarfleetText}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource StarfleetSilver}" />
                </StackPanel>

                <!-- Zeitraum -->
                <StackPanel Grid.Column="3" Grid.Row="1" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <shared:StarfleetIcon Icon="Calendar" Size="16"
                            Color="{StaticResource StarfleetSilver}" Margin="0,0,6,0" />
                        <TextBlock Text="Zeitraum"
                            Style="{StaticResource StarfleetMutedText}" />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding PlayerSummary.StartTime, StringFormat='{}{0:HH:mm:ss}'}"
                        Style="{StaticResource StarfleetText}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource StarfleetSilver}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>