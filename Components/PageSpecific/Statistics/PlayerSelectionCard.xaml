<UserControl x:Class="StoDamageMeter.Components.PageSpecific.Statistics.PlayerSelectionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    xmlns:converters="clr-namespace:StoDamageMeter.Converters">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </UserControl.Resources>

    <Border Style="{StaticResource StarfleetCardStyle}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <shared:StarfleetIcon Icon="User" Size="20"
                    Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                <TextBlock Text="Spieler-Auswahl"
                    Style="{StaticResource StarfleetTitle}" />
            </StackPanel>

            <!-- Spieler-ComboBox -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Spieler:"
                    Style="{StaticResource StarfleetSubtitle}"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0" />
                <ComboBox ItemsSource="{Binding AvailablePlayers}"
                    SelectedItem="{Binding SelectedPlayer}"
                    MinWidth="200"
                    Margin="0,0,12,0"
                    Background="{StaticResource Input}"
                    Foreground="{StaticResource Foreground}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1"
                    Padding="12,8"
                    FontSize="14" />
            </StackPanel>

            <!-- Keine Spieler -->
            <StackPanel HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Visibility="{Binding AvailablePlayers.Count, Converter={StaticResource NullToVisibilityConverter}}">
                <shared:StarfleetIcon Icon="Info" Size="32"
                    Color="{StaticResource StarfleetSilver}" />
                <TextBlock Text="Keine Spieler verfügbar"
                    Style="{StaticResource StarfleetMutedText}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>