<UserControl x:Class="StoDamageMeter.Components.PageSpecific.Statistics.WeaponStatisticsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    xmlns:converters="clr-namespace:StoDamageMeter.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Styles/DataGridStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:RowIndexConverter x:Key="RowIndexConverter" />
            <converters:TypeToIconConverter x:Key="TypeToIconConverter" />
            <converters:SourceTypeToIconConverter x:Key="SourceTypeToIconConverter" />
            <converters:SourceTypeToColorConverter x:Key="SourceTypeToColorConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource StarfleetCardStyle}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <shared:StarfleetIcon Icon="Chart" Size="20"
                    Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                <TextBlock Text="Waffen-Statistiken"
                    Style="{StaticResource StarfleetTitle}" />
            </StackPanel>

            <!-- Waffen-Statistiken Tabelle -->
            <DataGrid
                ItemsSource="{Binding WeaponStatistics}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="False"
                CanUserSortColumns="True"
                IsReadOnly="True"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                AlternatingRowBackground="Transparent"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                RowHeaderWidth="0"
                MaxHeight="400"
                MinWidth="900"
                Loaded="DataGrid_Loaded"
                SelectionChanged="DataGrid_SelectionChanged">

                <DataGrid.Columns>
                    <!-- # Reihenfolge -->
                    <DataGridTemplateColumn Header="#" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <shared:StarfleetBadge
                                    Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource RowIndexConverter}, ConverterParameter=Fixed}"
                                    Variant="Outline" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Source Type -->
                    <DataGridTemplateColumn Header="Quelle" Width="60"
                        HeaderStyle="{StaticResource DataGridHeaderCentering}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <shared:StarfleetIcon
                                        Icon="{Binding SourceType, Converter={StaticResource SourceTypeToIconConverter}}"
                                        Size="20"
                                        Color="{Binding SourceType, Converter={StaticResource SourceTypeToColorConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Waffen-Name -->
                    <DataGridTextColumn Header="Waffe"
                        Binding="{Binding Name}"
                        Width="*"
                        ElementStyle="{StaticResource DataGridNameStyle}" />

                    <!-- DPS -->
                    <DataGridTextColumn Header="DPS"
                        Binding="{Binding DPS, StringFormat='{}{0:N0}'}"
                        Width="60"
                        ElementStyle="{StaticResource DataGridDPStyle}"
                        HeaderStyle="{StaticResource DataGridHeaderRightAlign}" />

                    <!-- Ø Schaden -->
                    <DataGridTextColumn Header="Ø Schaden"
                        Binding="{Binding AverageDamage, StringFormat='{}{0:N0}'}"
                        Width="120"
                        ElementStyle="{StaticResource DataGridAverageStyle}"
                        HeaderStyle="{StaticResource DataGridHeaderRightAlign}" />

                    <!-- Gesamtschaden -->
                    <DataGridTextColumn Header="Gesamt"
                        Binding="{Binding TotalDamage, StringFormat='{}{0:N0}'}"
                        Width="80"
                        ElementStyle="{StaticResource DataGridTotalStyle}"
                        HeaderStyle="{StaticResource DataGridHeaderRightAlign}" />

                    <!-- Verwendungen -->
                    <DataGridTemplateColumn Width="60"
                        HeaderStyle="{StaticResource DataGridHeaderCentering}">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <shared:StarfleetIcon Icon="Star" Size="16"
                                    Color="{StaticResource StarfleetSilver}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalUses}"
                                        Style="{StaticResource DataGridUsageStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Kritische Treffer -->
                    <DataGridTextColumn Header="Krit Treffer"
                        Binding="{Binding CriticalHits}"
                        Width="100"
                        ElementStyle="{StaticResource DataGridCriticalStyle}"
                        HeaderStyle="{StaticResource DataGridHeaderRightAlign}" />

                    <!-- Kritische Rate -->
                    <DataGridTextColumn Header="Krit Rate"
                        Binding="{Binding CriticalRate, StringFormat='{}{0:F1}%'}"
                        Width="100"
                        ElementStyle="{StaticResource DataGridCriticalStyle}"
                        HeaderStyle="{StaticResource DataGridHeaderRightAlign}" />

                    <!-- Anteil -->
                    <DataGridTemplateColumn Header="Anteil" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <shared:StarfleetProgressBar
                                        Value="{Binding DamageShare}"
                                        Text="{Binding DamageShare, StringFormat='{}{0:F1}%'}"
                                        Height="16" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Keine Daten -->
            <StackPanel HorizontalAlignment="Center"
                Margin="0,40,0,0"
                Visibility="{Binding WeaponStatistics.Count, Converter={StaticResource NullToVisibilityConverter}}">
                <shared:StarfleetIcon Icon="Info" Size="48"
                    Color="{StaticResource StarfleetSilver}" />
                <TextBlock Text="Keine Waffen-Statistiken verfügbar"
                    Style="{StaticResource StarfleetMutedText}"
                    FontSize="16"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>