<UserControl x:Class="StoDamageMeter.Components.PageSpecific.Statistics.CombatOverviewCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    xmlns:converters="clr-namespace:StoDamageMeter.Converters">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </UserControl.Resources>

    <Border Style="{StaticResource StarfleetCardStyle}"
        Visibility="{Binding SelectedPlayer, Converter={StaticResource StringToVisibilityConverter}}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <shared:StarfleetIcon Icon="Chart" Size="20"
                    Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                <TextBlock Text="Kampf-Übersicht"
                    Style="{StaticResource StarfleetTitle}" />
            </StackPanel>

            <!-- 3 Kacheln in einer Reihe -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- DPS Kachel -->
                <Border Grid.Column="0"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,8,0"
                    Padding="20,16">
                    <StackPanel HorizontalAlignment="Center">
                        <shared:StarfleetIcon Icon="Chart" Size="32"
                            Color="{StaticResource StarfleetRed}"
                            HorizontalAlignment="Center" />
                        <TextBlock Text="Ø DPS"
                            Style="{StaticResource StarfleetMutedText}"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,4" />
                        <TextBlock Text="{Binding PlayerSummary.DPS, StringFormat='{}{0:N0}'}"
                            Style="{StaticResource StarfleetText}"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{StaticResource StarfleetRed}"
                            FontFamily="Consolas"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Krit Rate Kachel -->
                <Border Grid.Column="1"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="4,0"
                    Padding="20,16">
                    <StackPanel HorizontalAlignment="Center">
                        <shared:StarfleetIcon Icon="Star" Size="32"
                            Color="{StaticResource StarfleetBlue}"
                            HorizontalAlignment="Center" />
                        <TextBlock Text="Ø Krit Rate"
                            Style="{StaticResource StarfleetMutedText}"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,4" />
                        <TextBlock
                            Text="{Binding PlayerSummary.CriticalRate, StringFormat='{}{0:F1}%'}"
                            Style="{StaticResource StarfleetText}"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{StaticResource StarfleetBlue}"
                            FontFamily="Consolas"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Gesamtschaden Kachel -->
                <Border Grid.Column="2"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="8,0,0,0"
                    Padding="20,16">
                    <StackPanel HorizontalAlignment="Center">
                        <shared:StarfleetIcon Icon="Star" Size="32"
                            Color="{StaticResource StarfleetGold}"
                            HorizontalAlignment="Center" />
                        <TextBlock Text="Gesamtschaden"
                            Style="{StaticResource StarfleetMutedText}"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,4" />
                        <TextBlock
                            Text="{Binding PlayerSummary.TotalDamage, StringFormat='{}{0:N0}'}"
                            Style="{StaticResource StarfleetText}"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{StaticResource StarfleetGold}"
                            FontFamily="Consolas"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>