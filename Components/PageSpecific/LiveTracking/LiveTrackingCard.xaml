<UserControl x:Class="StoDamageMeter.Components.PageSpecific.LiveTracking.LiveTrackingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    mc:Ignorable="d"
    d:DesignHeight="120" d:DesignWidth="800">

    <Border Style="{StaticResource StarfleetCardStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left Side - Status Info -->
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <shared:StarfleetIcon Icon="LiveTracking" Size="16"
                        Color="{StaticResource StarfleetGreen}" Margin="0,0,8,0" />
                    <TextBlock Text="Live-Tracking Aktiv"
                        Style="{StaticResource StarfleetText}"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                        <shared:StarfleetIcon Icon="Chart" Size="16"
                            Color="{StaticResource StarfleetSilver}" Margin="0,0,8,0" />
                        <TextBlock Text="Events: 0"
                            Style="{StaticResource StarfleetMutedText}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <shared:StarfleetIcon Icon="Clock" Size="16"
                            Color="{StaticResource StarfleetSilver}" Margin="0,0,8,0" />
                        <TextBlock Text="Letztes Update: 6s"
                            Style="{StaticResource StarfleetMutedText}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Right Side - Stop Button -->
            <Button Grid.Column="1"
                Style="{StaticResource StarfleetButton}"
                Background="{StaticResource Destructive}"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <shared:StarfleetIcon Icon="Stop" Size="16"
                        Color="{StaticResource PrimaryForeground}" Margin="0,0,8,0" />
                    <TextBlock Text="Stoppen" Style="{StaticResource StarfleetText}" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>