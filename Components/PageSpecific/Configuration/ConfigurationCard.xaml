<UserControl x:Class="StoDamageMeter.Components.PageSpecific.Configuration.ConfigurationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    mc:Ignorable="d"
    d:DesignHeight="500" d:DesignWidth="600">

    <Border Style="{StaticResource StarfleetCardStyle}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <shared:StarfleetIcon Icon="Settings" Size="20"
                    Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                <TextBlock Text="Konfiguriere die Player Statistic"
                    Style="{StaticResource StarfleetSubtitle}" />
            </StackPanel>

            <!-- Auto-Refresh Section -->
            <StackPanel Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Auto-Refresh"
                            Style="{StaticResource StarfleetText}"
                            Margin="0,0,0,4" />
                        <TextBlock Text="Automatische Aktualisierung der Daten"
                            Style="{StaticResource StarfleetMutedText}" />
                    </StackPanel>
                    <CheckBox IsChecked="True"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Refresh-Intervall"
                        Style="{StaticResource StarfleetText}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="1s" Style="{StaticResource ToggleButton}"
                            Margin="0,0,8,0" />
                        <Button Content="2s" Style="{StaticResource ActiveToggleButton}"
                            Margin="0,0,8,0" />
                        <Button Content="5s" Style="{StaticResource ToggleButton}"
                            Margin="0,0,8,0" />
                        <Button Content="10s" Style="{StaticResource ToggleButton}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Current Settings -->
            <Border Background="{StaticResource Secondary}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <shared:StarfleetIcon Icon="Info" Size="16"
                            Color="{StaticResource StarfleetSilver}" Margin="0,0,8,0" />
                        <TextBlock Text="Aktuelle Einstellungen"
                            Style="{StaticResource StarfleetText}" />
                    </StackPanel>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Auto-Refresh:"
                                Style="{StaticResource StarfleetMutedText}"
                                Width="120" />
                            <shared:StarfleetBadge Text="Aktiv" Variant="Success" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Intervall:"
                                Style="{StaticResource StarfleetMutedText}"
                                Width="120" />
                            <TextBlock Text="2s"
                                Style="{StaticResource StarfleetText}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>