<UserControl x:Class="StoDamageMeter.Components.PageSpecific.Configuration.ConfigurationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="500" d:DesignWidth="600">

    <Border Style="{StaticResource ModernCardStyle}">
        <ScrollViewer Margin="24">
            <StackPanel>
                <TextBlock Text="Konfiguriere die Player Statistic"
                    Style="{StaticResource ModernSubtitle}"
                    Margin="0,0,0,24" />

                <!-- Auto-Refresh Section -->
                <StackPanel Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Auto-Refresh"
                                Style="{StaticResource ModernText}"
                                Margin="0,0,0,4" />
                            <TextBlock Text="Automatische Aktualisierung der Daten"
                                Style="{StaticResource ModernMutedText}" />
                        </StackPanel>
                        <CheckBox IsChecked="True"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Refresh-Intervall"
                            Style="{StaticResource ModernText}"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="1s" Style="{StaticResource ToggleButton}"
                                Margin="0,0,8,0" />
                            <Button Content="2s" Style="{StaticResource ActiveToggleButton}"
                                Margin="0,0,8,0" />
                            <Button Content="5s" Style="{StaticResource ToggleButton}"
                                Margin="0,0,8,0" />
                            <Button Content="10s" Style="{StaticResource ToggleButton}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Current Settings -->
                <Border Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel>
                        <TextBlock Text="Aktuelle Einstellungen"
                            Style="{StaticResource ModernText}"
                            Margin="0,0,0,16" />

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Auto-Refresh:"
                                    Style="{StaticResource ModernSecondaryText}"
                                    Width="120" />
                                <TextBlock Text="Aktiv"
                                    Style="{StaticResource ModernText}"
                                    Foreground="{StaticResource SuccessGreen}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Intervall:"
                                    Style="{StaticResource ModernSecondaryText}"
                                    Width="120" />
                                <TextBlock Text="2s"
                                    Style="{StaticResource ModernText}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>