<UserControl x:Class="StoDamageMeter.Components.PageSpecific.Dashboard.FileSelectionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    mc:Ignorable="d"
    d:DesignHeight="300" d:DesignWidth="400">

    <Border Style="{StaticResource StarfleetCardStyle}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <shared:StarfleetIcon Icon="FileText" Size="20"
                    Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                <TextBlock Text="Log Datei"
                    Style="{StaticResource StarfleetSubtitle}" />
            </StackPanel>
            <TextBlock Text="Wähle eine STO Combat Log Datei aus"
                Style="{StaticResource StarfleetMutedText}"
                Margin="0,0,0,24" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Command="{Binding CombatLog.SelectLogFileCommand}"
                    Style="{StaticResource StarfleetButton}"
                    IsEnabled="{Binding CombatLog.IsProcessing, Converter={StaticResource InvertBooleanConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <shared:StarfleetIcon Icon="Upload" Size="16"
                            Color="{StaticResource PrimaryForeground}" Margin="0,0,8,0" />
                        <TextBlock Text="Log-Datei auswählen" Style="{StaticResource StarfleetText}" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding CombatLog.StartWatchingCommand}"
                    Style="{StaticResource StarfleetButton}"
                    Margin="12,0,0,0"
                    IsEnabled="{Binding CombatLog.IsWatching, Converter={StaticResource InvertBooleanConverter}}"
                    Visibility="{Binding CombatLog.SelectedLogFile, Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <shared:StarfleetIcon Icon="Play" Size="16"
                            Color="{StaticResource PrimaryForeground}" Margin="0,0,8,0" />
                        <TextBlock Text="Überwachung starten" Style="{StaticResource StarfleetText}" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding CombatLog.StopWatchingCommand}"
                    Style="{StaticResource StarfleetButton}"
                    Margin="12,0,0,0"
                    IsEnabled="{Binding CombatLog.IsWatching}"
                    Visibility="{Binding CombatLog.IsWatching, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <shared:StarfleetIcon Icon="Stop" Size="16"
                            Color="{StaticResource PrimaryForeground}" Margin="0,0,8,0" />
                        <TextBlock Text="Überwachung stoppen" Style="{StaticResource StarfleetText}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Status-Anzeige -->
            <Border Background="{StaticResource Secondary}"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <shared:StarfleetIcon Icon="Info" Size="14"
                            Color="{StaticResource StarfleetSilver}" Margin="0,0,4,0" />
                        <TextBlock Text="Status"
                            Style="{StaticResource StarfleetMutedText}"
                            FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                        Style="{StaticResource StarfleetText}" />
                    <TextBlock Text="{Binding LastUpdate, StringFormat='Letztes Update: {0}'}"
                        Style="{StaticResource StarfleetMutedText}"
                        Margin="0,4,0,0"
                        Visibility="{Binding LastUpdate, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Unterstützte Formate: .log, .txt (max. 100MB)"
                Style="{StaticResource StarfleetMutedText}" />

            <TextBlock Text="{Binding SelectedLogFile}"
                Style="{StaticResource StarfleetMutedText}"
                Margin="0,16,0,0"
                TextWrapping="Wrap"
                Visibility="{Binding SelectedLogFile, Converter={StaticResource StringToVisibilityConverter}}" />
        </StackPanel>
    </Border>
</UserControl>