<UserControl x:Class="StoDamageMeter.Components.LiveTrackingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="800">
    
    <Border Style="{StaticResource ModernCardStyle}">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Side - Status Info -->
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Ellipse Width="12" Height="12" 
                             Fill="{StaticResource SuccessGreen}" 
                             Margin="0,0,12,0"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="Live-Tracking Aktiv" 
                               Style="{StaticResource ModernText}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                        <TextBlock Text="📊" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Events: 0" 
                                   Style="{StaticResource ModernSecondaryText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🕐" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Letztes Update: 6s" 
                                   Style="{StaticResource ModernSecondaryText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            
            <!-- Right Side - Stop Button -->
            <Button Grid.Column="1" 
                    Content="Stoppen"
                    Background="{StaticResource ErrorRed}"
                    Foreground="{StaticResource TextPrimary}"
                    BorderThickness="0"
                    Padding="20,12"
                    FontWeight="SemiBold"
                    FontSize="14"
                    VerticalAlignment="Center"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}">
                                <Ellipse Width="8" Height="8" 
                                         Fill="{StaticResource TextPrimary}" 
                                         Margin="0,0,8,0"/>
                                <TextBlock Text="{TemplateBinding Content}" 
                                           Foreground="{TemplateBinding Foreground}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           FontSize="{TemplateBinding FontSize}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>
