<Window x:Class="StoDamageMeter.CombatStatistic"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StoDamageMeter"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:combat="clr-namespace:StoDamageMeter.Components.Combat"
        xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
        xmlns:liveCombat="clr-namespace:StoDamageMeter.Components.LiveCombat"
        mc:Ignorable="d"
        Title="STO Damage Meter - Combat Statistics" 
        Height="800" 
        Width="1200"
        MinHeight="400"
        MinWidth="600"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">
    
    <Window.Resources>
        <!-- Import Styles -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/ExpanderStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border BorderBrush="#404040" 
            BorderThickness="1" 
            CornerRadius="6"
            Background="#DD000000">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar (Draggable) -->
        <Border x:Name="TitleBarBorder"
                Grid.Row="0"
                Background="#33000000"
                CornerRadius="5,5,0,0"
                Height="32"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" 
                           Orientation="Horizontal"
                           Margin="12,0,0,0">
                    <TextBlock x:Name="TitleText"
                              Text="📊 Combat Statistics"
                              FontSize="12"
                              Foreground="#5B9BD5"
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Pin Button -->
                <Button x:Name="PinButton"
                        Grid.Column="1"
                        Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="PinButton_Click"
                        Margin="0,0,2,0"
                        Cursor="Hand">
                    <TextBlock x:Name="PinIcon"
                               Text="📌" 
                               FontSize="12" 
                               Foreground="#E0E0E0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
                
                <!-- Close Button -->
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_Click"
                        Cursor="Hand">
                    <TextBlock Text="✕" 
                               FontSize="12" 
                               Foreground="#E0E0E0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*"/>
                <ColumnDefinition Width="80*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Combat List -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource StarTrekDarkGray}" 
                    BorderBrush="{DynamicResource StarTrekBorderGray}" 
                    BorderThickness="0,0,1,0">
                <!-- Combat List -->
                <ui:Card Margin="16" Padding="0">
                    <combat:CombatListView x:Name="CombatListViewComponent" 
                                           Margin="0"/>
                </ui:Card>
            </Border>
            
            <!-- Right Data Area -->
            <Grid Grid.Column="1" Background="{DynamicResource StarTrekDeepBlack}">
                <!-- Statistics View (no tabs) -->
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                
                    <!-- Data Table Area -->
                    <ui:Card Grid.Row="1" Margin="16,8,16,16" Padding="20" VerticalAlignment="Top">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                                            
                            <!-- Column Headers Component -->
                            <combat:CombatStatsHeader x:Name="StatsHeaderComponent" 
                                                      Grid.Row="1" 
                                                      Margin="0,0,0,4"/>
                        
                            <!-- Data Table Container -->
                            <Border Grid.Row="2"
                                    Background="{DynamicResource StarTrekDarkGray}"
                                    BorderBrush="{DynamicResource StarTrekBorderGray}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid>
                                    <!-- Empty State -->
                                    <StackPanel x:Name="EmptyCombatStatsPanel" 
                                                HorizontalAlignment="Center" 
                                                VerticalAlignment="Center" 
                                                Margin="0,40">
                                        <ui:SymbolIcon Symbol="Table24" 
                                                       FontSize="48" 
                                                       Foreground="{DynamicResource StarTrekBlue}"
                                                       Opacity="0.3"
                                                       Margin="0,0,0,12"/>
                                        <TextBlock Text="Select a combat to view statistics" 
                                                   Foreground="{DynamicResource StarTrekTextGray}"
                                                   HorizontalAlignment="Center"
                                                   Opacity="0.6"/>
                                        <TextBlock Text="Click on a combat from the list above" 
                                                   Foreground="{DynamicResource StarTrekTextGray}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,0"
                                                   FontSize="11"
                                                   Opacity="0.5"/>
                                    </StackPanel>
                                    
                                    <!-- Loading Indicator -->
                                    <StackPanel x:Name="LoadingCombatStatsPanel" 
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Center" 
                                                VerticalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True" 
                                                     Width="200" 
                                                     Height="4"
                                                     Margin="0,0,0,12"/>
                                        <TextBlock x:Name="LoadingCombatStatsText"
                                                   Text="Loading combat statistics..." 
                                                   Foreground="{DynamicResource StarTrekTextGray}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <!-- Data Table with Expandable Rows -->
                                    <ScrollViewer x:Name="CombatStatsScrollViewer"
                                                  Visibility="Collapsed"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalAlignment="Top">
                                        <ItemsControl x:Name="CombatStatsItemsControl"
                                                      Background="Transparent"
                                                      Margin="0"
                                                      Padding="8"
                                                      VerticalAlignment="Top">
                                            <!-- Hier wird die Tabelle dynamisch gefüllt -->
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </ui:Card>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
    </Border>
</Window>