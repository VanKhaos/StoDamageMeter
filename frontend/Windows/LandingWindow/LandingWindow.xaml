<Window x:Class="StoDamageMeter.LandingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STO Damage Meter" 
        Height="120" 
        Width="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Animation für Icon Fade In/Out -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetName="IconPanel" 
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="ClosePinPanel" 
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        
        <Storyboard x:Key="FadeOutAnimation">
            <DoubleAnimation Storyboard.TargetName="IconPanel" 
                           Storyboard.TargetProperty="Opacity"
                           From="1" To="0" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="ClosePinPanel" 
                           Storyboard.TargetProperty="Opacity"
                           From="1" To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>
    
    <Viewbox Stretch="Uniform">
        <Grid Width="100" Height="100" 
              MouseEnter="ShowButtons"
              MouseLeave="StartHideTimer">
            
            <!-- Haupt-Logo -->
            <Image x:Name="LogoImage" 
                   Source="/Assets/app_icon.png" 
                   Width="100" 
                   Height="100"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   MouseLeftButtonDown="LogoImage_MouseLeftButtonDown"
                   MouseMove="LogoImage_MouseMove"
                   MouseLeftButtonUp="LogoImage_MouseLeftButtonUp"/>
        
            <!-- Icon Panel (nur bei Hover sichtbar) -->
            <StackPanel x:Name="IconPanel" 
                        Opacity="0"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Margin="0,0,5,0">
            
            <!-- Dashboard Icon -->
                    <Button x:Name="DashboardButton" 
                            Width="18" Height="18" 
                            Margin="0,0,0,5"
                            BorderThickness="0"
                            Click="DashboardButton_Click"
                            ToolTip="Dashboard"
                            Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="#5B9BD5" Stroke="#4A8BC2" StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="📊" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            
            <!-- Graph Icon -->
                    <Button x:Name="GraphButton" 
                            Width="18" Height="18" 
                            Margin="0,0,0,5"
                            BorderThickness="0"
                            Click="GraphButton_Click"
                            ToolTip="Graph"
                            Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="#28A745" Stroke="#1E7E34" StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="📈" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            
            <!-- Overlay Icon -->
                    <Button x:Name="OverlayButton" 
                            Width="18" Height="18" 
                            Margin="0,0,0,5"
                            BorderThickness="0"
                            Click="OverlayButton_Click"
                            ToolTip="Live Combat Overlay"
                            Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="#FFC107" Stroke="#E0A800" StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="🎯" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            
            <!-- Log Icon -->
                    <Button x:Name="LogButton" 
                            Width="18" Height="18" 
                            Margin="0,0,0,5"
                            BorderThickness="0"
                            Click="LogButton_Click"
                            ToolTip="Combat Log"
                            Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="#6F42C1" Stroke="#5A32A3" StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="📄" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            
            </StackPanel>
            
            <!-- Close & Pin Buttons Panel (links oben, überlappt Logo) -->
            <StackPanel x:Name="ClosePinPanel" 
                        Opacity="0"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top"
                        Margin="5,10,0,0">
            
            <!-- Schließen Button (oben) -->
            <Button x:Name="CloseButton" 
                    Width="15" Height="15" 
                    Margin="0,0,0,5"
                    BorderThickness="0"
                    Click="CloseButton_Click"
                    ToolTip="Close"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="#DC3545" Stroke="#C82333" StrokeThickness="2"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="✕" FontSize="8" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White"/>
            </Button>
            
            <!-- Pin Button (unten) -->
            <Button x:Name="PinButton" 
                    Width="15" Height="15" 
                    BorderThickness="0"
                    Click="PinButton_Click"
                    ToolTip="Pin/Unpin Window"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="#17A2B8" Stroke="#138496" StrokeThickness="2"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="PinIcon" Text="📌" FontSize="8" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White"/>
            </Button>
            </StackPanel>
        </Grid>
    </Viewbox>
</Window>
