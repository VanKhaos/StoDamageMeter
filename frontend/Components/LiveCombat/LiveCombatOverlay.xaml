<Window x:Class="StoDamageMeter.Components.LiveCombat.LiveCombatOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Live Combat Stats"
        Height="350" 
        Width="450"
        MinHeight="150"
        MinWidth="300"
        Background="Transparent"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">
    
    <Window.Resources>
        <SolidColorBrush x:Key="StarTrekBlue" Color="#5B9BD5"/>
        <SolidColorBrush x:Key="OverlayBackground" Color="#DD000000"/><!-- 87% transparent black -->
        <SolidColorBrush x:Key="StarTrekTextGray" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="StarTrekBorderGray" Color="#404040"/>
    </Window.Resources>
    
    <Border BorderBrush="{StaticResource StarTrekBorderGray}" 
            BorderThickness="1" 
            CornerRadius="6"
            Background="{StaticResource OverlayBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Minimal Title Bar (Draggable) - nur 24px hoch -->
            <Border x:Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="#33000000"
                    CornerRadius="5,5,0,0"
                    Height="24"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" 
                               Orientation="Horizontal"
                               Margin="8,0,0,0">
                        <TextBlock x:Name="TitleText"
                                  Text="🚀 Live Combat"
                                  FontSize="11"
                                  Foreground="{StaticResource StarTrekBlue}"
                                  VerticalAlignment="Center"/>
                        <TextBlock x:Name="DurationText"
                                  Text=""
                                  FontSize="10"
                                  Foreground="{StaticResource StarTrekTextGray}"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Demo Button -->
                    <Button x:Name="DemoButton"
                            Grid.Column="1"
                            Content="🎬"
                            FontSize="11"
                            Width="24"
                            Height="24"
                            Background="Transparent"
                            Foreground="#B0B0B0"
                            BorderThickness="0"
                            Click="DemoButton_Click"
                            Cursor="Hand"
                            Padding="0"
                            ToolTip="Demo-Modus">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#B0B0B0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#CC333333"/>
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <!-- Settings Button -->
                    <Button x:Name="SettingsButton"
                            Grid.Column="2"
                            Content="⚙"
                            FontSize="11"
                            Width="24"
                            Height="24"
                            Background="Transparent"
                            Foreground="#B0B0B0"
                            BorderThickness="0"
                            Click="SettingsButton_Click"
                            Cursor="Hand"
                            Padding="0"
                            ToolTip="Einstellungen">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#B0B0B0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#CC333333"/>
                                        <Setter Property="Foreground" Value="{StaticResource StarTrekBlue}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <!-- Pin Button -->
                    <Button x:Name="PinButton"
                            Grid.Column="3"
                            Content="📍"
                            FontSize="11"
                            Width="24"
                            Height="24"
                            Background="Transparent"
                            Foreground="#B0B0B0"
                            BorderThickness="0"
                            Click="PinButton_Click"
                            Cursor="Hand"
                            Padding="0"
                            ToolTip="Verankern">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#B0B0B0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#CC333333"/>
                                        <Setter Property="Foreground" Value="{StaticResource StarTrekBlue}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <!-- Close Button -->
                    <Button Grid.Column="4"
                            Content="✕"
                            FontSize="12"
                            Width="24"
                            Height="24"
                            Background="Transparent"
                            Foreground="#B0B0B0"
                            BorderThickness="0"
                            Click="CloseButton_Click"
                            Cursor="Hand"
                            Padding="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#B0B0B0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                   CornerRadius="0,5,0,0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#CC333333"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Content Area -->
            <Border Grid.Row="1"
                    Margin="4"
                    Background="Transparent"
                    CornerRadius="0,0,4,4">
                <Grid Margin="4">
                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="⏳"
                                  FontSize="32"
                                  HorizontalAlignment="Center"
                                  Opacity="0.4"
                                  Margin="0,0,0,8"/>
                        <TextBlock Text="Warte auf Combat..."
                                  Foreground="{StaticResource StarTrekTextGray}"
                                  HorizontalAlignment="Center"
                                  FontSize="11"
                                  Opacity="0.7"/>
                    </StackPanel>
                    
                    <!-- Data Table -->
                    <ScrollViewer x:Name="DataScrollViewer"
                                 Visibility="Collapsed"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header Row - kompakt -->
                            <Grid Grid.Row="0"
                                 Background="#22000000"
                                 Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="85"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0"
                                          Text="Spieler"
                                          FontSize="11"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource StarTrekBlue}"
                                          Padding="8,4"
                                          VerticalAlignment="Center"/>
                                
                                <TextBlock Grid.Column="1"
                                          Text="DPS"
                                          FontSize="11"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource StarTrekBlue}"
                                          Padding="4"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"/>
                                
                                <TextBlock Grid.Column="2"
                                          Text="Total"
                                          FontSize="11"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource StarTrekBlue}"
                                          Padding="4,4,8,4"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!-- Data Rows -->
                            <ItemsControl x:Name="PlayersItemsControl"
                                         Grid.Row="1"
                                         Background="Transparent">
                                <!-- Items werden dynamisch hinzugefügt -->
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- Settings Popup -->
            <Border x:Name="SettingsPopup"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Background="#DD000000"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="SettingsPopup_MouseDown">
                <Border Background="{StaticResource OverlayBackground}"
                        BorderBrush="{StaticResource StarTrekBorderGray}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Width="250"
                        Height="150"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <TextBlock Grid.Row="0"
                                  Text="⚙ Einstellungen"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource StarTrekBlue}"
                                  Margin="0,0,0,12"/>
                        
                        <!-- Font Size Label -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Schriftgröße:"
                                      FontSize="11"
                                      Foreground="{StaticResource StarTrekTextGray}"
                                      VerticalAlignment="Center"
                                      Width="80"/>
                            <TextBlock x:Name="FontSizeLabel"
                                      Text="16"
                                      FontSize="11"
                                      Foreground="{StaticResource StarTrekBlue}"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"
                                      Margin="8,0,0,0"/>
                        </StackPanel>
                        
                        <!-- Font Size Slider -->
                        <Slider x:Name="FontSizeSlider"
                                Grid.Row="2"
                                Minimum="10"
                                Maximum="24"
                                Value="16"
                                TickFrequency="2"
                                IsSnapToTickEnabled="True"
                                ValueChanged="FontSizeSlider_ValueChanged"
                                Margin="0,0,0,12"/>
                        
                        <!-- Close Button -->
                        <Button Grid.Row="3"
                                Content="Schließen"
                                Width="80"
                                Height="28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Click="CloseSettingsPopup_Click"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource StarTrekBlue}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                       CornerRadius="4"
                                                       Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#7BAED5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
