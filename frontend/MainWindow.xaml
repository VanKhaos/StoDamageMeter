<ui:FluentWindow x:Class="StoDamageMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:local="clr-namespace:StoDamageMeter"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="STO Damage Meter" 
        Height="800" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <ui:TitleBar 
            Grid.Row="0"
            Title="STO Damage Meter"
            Icon="{ui:SymbolIcon ChartMultiple24}">
        </ui:TitleBar>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Sidebar -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource StarTrekDarkGray}"
                    BorderBrush="{DynamicResource StarTrekBorderGray}" 
                    BorderThickness="0,0,1,0"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Combat Log Selection Card -->
                        <ui:Card Margin="0,0,0,16" Padding="16">
                            <StackPanel>
                                <TextBlock Text="STO Combatlog" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StarTrekBlue}"
                                           Margin="0,0,0,12"/>
                                
                                <ui:TextBox x:Name="LogFilePathTextBox"
                                            PlaceholderText="Select a combat log file..."
                                            Icon="{ui:SymbolIcon Document24}"
                                            Margin="0,0,0,12"/>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <ui:Button x:Name="BrowseButton"
                                               Content="Browse"
                                               Icon="{ui:SymbolIcon FolderOpen24}"
                                               Appearance="Secondary"
                                               Margin="0,0,8,0"
                                               Click="BrowseButton_Click"/>
                    </StackPanel>
                    
                                <!-- Progress Bar -->
                                <ProgressBar x:Name="LoadingProgressBar"
                                             Visibility="Collapsed"
                                             IsIndeterminate="False"
                                             Minimum="0"
                                             Maximum="100"
                                             Height="4"
                                             Margin="0,8,0,4"/>
                                <TextBlock x:Name="LoadingStatusText"
                                           Visibility="Collapsed"
                                           FontSize="11"
                                           Foreground="{DynamicResource StarTrekTextGray}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </ui:Card>
                        
                        <!-- Combat List Card -->
                        <ui:Card Margin="0,0,0,16" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Combat List" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StarTrekBlue}"
                                           Margin="0,0,0,12"/>
                                
                                <Border Background="{DynamicResource StarTrekDeepBlack}"
                                        BorderBrush="{DynamicResource StarTrekBorderGray}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Height="300">
                                    <Grid>
                                        <!-- Empty State -->
                                        <TextBlock x:Name="EmptyCombatListText"
                                                   Text="Select a combat log file to view combats..." 
                                                   Foreground="{DynamicResource StarTrekTextGray}"
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   Opacity="0.6"/>
                                        
                                        <!-- Combat List -->
                                        <ListView x:Name="CombatListView" 
                                                  Margin="8"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  SelectionChanged="CombatListView_SelectionChanged">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                                    <Setter Property="Background" Value="{DynamicResource StarTrekDarkGray}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListViewItem">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="4"
                                                                        Padding="12,8">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <!-- Hover Effect -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#2A2A2A"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource StarTrekBlue}"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                        </Trigger>
                                                        <!-- Selected Effect -->
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#1E3A5F"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource StarTrekBlue}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Combat Type Icon -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Icon}" 
                                                                   FontSize="16"
                                                                   Foreground="{DynamicResource StarTrekBlue}"
                                                                   Margin="0,0,8,0"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="{Binding Type}"/>
                                                        <!-- Date -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Date}" 
                                                                   Foreground="White"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Left"/>
                                                        <!-- Time -->
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Time}" 
                                                                   Foreground="{DynamicResource StarTrekTextGray}"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                        </Border>
                            </StackPanel>
                        </ui:Card>
                        
                        <!-- Info Card -->
                        <ui:Card Padding="16">
                            <StackPanel>
                                <TextBlock Text="Statistics" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StarTrekBlue}"
                                           Margin="0,0,0,12"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:SymbolIcon Symbol="Timer24" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Log Duration:" 
                                               Foreground="{DynamicResource StarTrekTextGray}"
                                               Margin="0,0,6,0"/>
                                    <TextBlock x:Name="LogDurationText"
                                               Text="0s" 
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                    </StackPanel>
                    
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:SymbolIcon Symbol="Person24" FontSize="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Player Duration:" 
                                               Foreground="{DynamicResource StarTrekTextGray}"
                                               Margin="0,0,6,0"/>
                                    <TextBlock x:Name="PlayerDurationText"
                                               Text="0s" 
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                                
                                <ui:HyperlinkButton Content="Map Detection Details"
                                                    Icon="{ui:SymbolIcon Info24}"
                                                    Margin="0,8,0,0"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Right Data Area -->
            <Grid Grid.Column="1" Background="{DynamicResource StarTrekDeepBlack}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>
                
                <!-- Filter Bar -->
                <ui:Card Grid.Row="0" Margin="16,16,16,8" Padding="16">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Damage Out"
                                   Icon="{ui:SymbolIcon ArrowExportLtr24}"
                                   Appearance="Primary"
                                   Margin="0,0,8,0"/>
                        
                        <ui:Button Content="Damage Taken"
                                   Icon="{ui:SymbolIcon ArrowImport24}"
                                   Appearance="Secondary"
                                   Margin="0,0,8,0"/>
                        
                        <ui:Button Content="Heals Out"
                                   Icon="{ui:SymbolIcon HeartPulse24}"
                                   Appearance="Secondary"
                                   Margin="0,0,8,0"/>
                        
                        <ui:Button Content="Heals In"
                                   Icon="{ui:SymbolIcon Heart24}"
                                   Appearance="Secondary"
                                   Margin="0,0,20,0"/>
                        
                        <ComboBox Width="150" 
                                  SelectedIndex="0"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="Selection"/>
                            <ComboBoxItem Content="All Players"/>
                            <ComboBoxItem Content="Top 5"/>
                        </ComboBox>
                        
                        <ui:Button Icon="{ui:SymbolIcon Settings24}"
                                   Appearance="Secondary"
                                   Margin="12,0,0,0"
                                   ToolTip="Settings"/>
                    </StackPanel>
                </ui:Card>
                
                <!-- DPS Graph Area -->
                <ui:Card Grid.Row="1" Margin="16,8,16,8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" 
                                   Text="DPS Over Time" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource StarTrekBlue}"
                                   Margin="0,0,0,12"/>
                        
                        <Border Grid.Row="1"
                                Background="{DynamicResource StarTrekDarkGray}"
                                BorderBrush="{DynamicResource StarTrekBorderGray}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ChartMultiple24" 
                                                   FontSize="48" 
                                                   Foreground="{DynamicResource StarTrekBlue}"
                                                   Opacity="0.3"
                                                   Margin="0,0,0,12"/>
                                    <TextBlock Text="DPS Graph will be displayed here" 
                                               Foreground="{DynamicResource StarTrekTextGray}"
                                               HorizontalAlignment="Center"
                                               Opacity="0.6"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ui:Card>
                
                <!-- Data Table Area -->
                <ui:Card Grid.Row="2" Margin="16,8,16,16" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                        <!-- Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Combat Statistics - Damage Out" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource StarTrekBlue}"
                                       VerticalAlignment="Center"/>
                            
                            <ui:Button Content="Export"
                                       Icon="{ui:SymbolIcon Save24}"
                                       Appearance="Secondary"
                                       Margin="16,0,0,0"
                                       FontSize="12"/>
                        </StackPanel>
                        
                        <!-- Column Headers -->
                        <Border Grid.Row="1" 
                                Background="{DynamicResource StarTrekDeepBlack}"
                                BorderBrush="{DynamicResource StarTrekBorderGray}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8"
                                Margin="0,0,0,4">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>      <!-- Player/Ability: mehr Platz -->
                                    <ColumnDefinition Width="1*"/>      <!-- DPS -->
                                    <ColumnDefinition Width="1.2*"/>    <!-- Total Damage -->
                                    <ColumnDefinition Width="1*"/>      <!-- Max Hit -->
                                    <ColumnDefinition Width="0.7*"/>    <!-- Crit % -->
                                    <ColumnDefinition Width="0.7*"/>    <!-- Acc % -->
                                </Grid.ColumnDefinitions>
                                
                                <!-- Player/Ability Header (nicht sortierbar, keine Trennlinie) -->
                                <TextBlock Grid.Column="0"
                                           Text="Player / Ability" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource StarTrekBlue}"
                                           Padding="0,0,8,0"/>
                                
                                <!-- DPS Header (sortierbar) -->
                                <Button x:Name="DpsHeaderButton"
                                        Grid.Column="1"
                                        Content="DPS"
                                        Tag="DpsWithCompanions"
                                        Click="OnColumnHeaderClick"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StarTrekBlue}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderThickness="0"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <!-- Total Damage Header (sortierbar) -->
                                <Button x:Name="TotalDamageHeaderButton"
                                        Grid.Column="2"
                                        Content="Total Damage"
                                        Tag="TotalDamageWithCompanions"
                                        Click="OnColumnHeaderClick"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StarTrekBlue}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderThickness="0"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <!-- Max Hit Header (sortierbar) -->
                                <Button x:Name="MaxHitHeaderButton"
                                        Grid.Column="3"
                                        Content="Max Hit"
                                        Tag="MaxOneHit"
                                        Click="OnColumnHeaderClick"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StarTrekBlue}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderThickness="0"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <!-- Crit % Header (sortierbar) -->
                                <Button x:Name="CritHeaderButton"
                                        Grid.Column="4"
                                        Content="Crit %"
                                        Tag="CritPercent"
                                        Click="OnColumnHeaderClick"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StarTrekBlue}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderThickness="0"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <!-- Acc % Header (sortierbar) -->
                                <Button x:Name="AccHeaderButton"
                                        Grid.Column="5"
                                        Content="Acc %"
                                        Tag="AccuracyPercent"
                                        Click="OnColumnHeaderClick"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StarTrekBlue}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderThickness="0"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                        </Grid>
                    </Border>
                    
                        <!-- Data Area -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource StarTrekDarkGray}"
                                BorderBrush="{DynamicResource StarTrekBorderGray}"
                                BorderThickness="1"
                                CornerRadius="4">
                        <Grid>
                                <!-- Empty State -->
                                <StackPanel x:Name="EmptyCombatStatsPanel" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" 
                                            Margin="0,40">
                                    <ui:SymbolIcon Symbol="Table24" 
                                                   FontSize="48" 
                                                   Foreground="{DynamicResource StarTrekBlue}"
                                                   Opacity="0.3"
                                                   Margin="0,0,0,12"/>
                                    <TextBlock Text="Select a combat to view statistics" 
                                               Foreground="{DynamicResource StarTrekTextGray}"
                                               HorizontalAlignment="Center"
                                               Opacity="0.6"/>
                                    <TextBlock Text="Click on a combat from the list above" 
                                               Foreground="{DynamicResource StarTrekTextGray}"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"
                                               FontSize="11"
                                               Opacity="0.5"/>
                                </StackPanel>
                                
                                <!-- Loading Indicator -->
                                <StackPanel x:Name="LoadingCombatStatsPanel" 
                                            Visibility="Collapsed"
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True" 
                                                 Width="200" 
                                                 Height="4"
                                                 Margin="0,0,0,12"/>
                                    <TextBlock x:Name="LoadingCombatStatsText"
                                               Text="Loading combat statistics..." 
                                               Foreground="{DynamicResource StarTrekTextGray}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- Data Table with Expandable Rows -->
                                <ScrollViewer x:Name="CombatStatsScrollViewer"
                                              Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="CombatStatsItemsControl"
                                                  Background="Transparent"
                                                  Padding="8">
                                        <!-- Hier wird die Tabelle dynamisch gefüllt -->
                                    </ItemsControl>
                                </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
