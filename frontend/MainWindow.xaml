<ui:FluentWindow x:Class="StoDamageMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:local="clr-namespace:StoDamageMeter"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:combat="clr-namespace:StoDamageMeter.Components.Combat"
        xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
        xmlns:liveCombat="clr-namespace:StoDamageMeter.Components.LiveCombat"
        mc:Ignorable="d"
        Title="STO Damage Meter" 
        Height="800" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    
    <ui:FluentWindow.Resources>
        <!-- Import Styles -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ExpanderStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <ui:TitleBar 
            Grid.Row="0"
            Title="STO Damage Meter"
            Icon="Assets/app_icon.png">
        </ui:TitleBar>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Sidebar -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource StarTrekDarkGray}"
                    BorderBrush="{DynamicResource StarTrekBorderGray}" 
                    BorderThickness="0,0,1,0"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Combat Log Selection Card -->
                    <ui:Card Grid.Row="0" Margin="0,0,0,16" Padding="16">
                        <StackPanel>
                            <TextBlock Text="STO Combatlog" 
                                       FontSize="14" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource StarTrekBlue}"
                                       Margin="0,0,0,12"/>
                            
                            <ui:TextBox x:Name="LogFilePathTextBox"
                                        PlaceholderText="Select a combat log file..."
                                        Icon="{ui:SymbolIcon Document24}"
                                        Margin="0,0,0,12"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <ui:Button x:Name="BrowseButton"
                                           Content="Browse"
                                           Icon="{ui:SymbolIcon FolderOpen24}"
                                           Appearance="Secondary"
                                           Margin="0,0,8,0"
                                           Click="BrowseButton_Click"/>
                            </StackPanel>
                
                            <!-- Progress Bar -->
                            <ProgressBar x:Name="LoadingProgressBar"
                                         Visibility="Collapsed"
                                         IsIndeterminate="False"
                                         Minimum="0"
                                         Maximum="100"
                                         Height="4"
                                         Margin="0,8,0,4"/>
                            <TextBlock x:Name="LoadingStatusText"
                                       Visibility="Collapsed"
                                       FontSize="11"
                                       Foreground="{DynamicResource StarTrekTextGray}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </ui:Card>
                    
                    <!-- Combat List Component -->
                    <combat:CombatListView x:Name="CombatListViewComponent" 
                                           Grid.Row="1"
                                           Margin="0"/>
                </Grid>
            </Border>
            
            <!-- Right Data Area -->
            <Grid Grid.Column="1" Background="{DynamicResource StarTrekDeepBlack}">
                <!-- Tab Control for different views -->
                <TabControl x:Name="MainTabControl" 
                           Margin="16"
                           Background="Transparent"
                           BorderThickness="0"
                           SelectionChanged="MainTabControl_SelectionChanged">
                    
                    <!-- Tab 1: Damage Out (Historical Combats) -->
                    <TabItem Header="Dashboard">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Filter Bar -->
                            <!-- <ui:Card Grid.Row="0" Margin="0,0,0,8" Padding="16">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Damage Out"
                                               Icon="{ui:SymbolIcon ArrowExportLtr24}"
                                               Appearance="Primary"
                                               Margin="0,0,8,0"/>
                                    
                                    <ui:Button Content="Damage Taken"
                                               Icon="{ui:SymbolIcon ArrowImport24}"
                                               Appearance="Secondary"
                                               Margin="0,0,8,0"/>
                                    
                                    <ui:Button Content="Heals Out"
                                               Icon="{ui:SymbolIcon HeartPulse24}"
                                               Appearance="Secondary"
                                               Margin="0,0,8,0"/>
                                    
                                    <ui:Button Content="Heals In"
                                               Icon="{ui:SymbolIcon Heart24}"
                                               Appearance="Secondary"
                                               Margin="0,0,20,0"/>
                                    
                                    <ComboBox Width="150" 
                                              SelectedIndex="0"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Content="Selection"/>
                                        <ComboBoxItem Content="All Players"/>
                                        <ComboBoxItem Content="Top 5"/>
                                    </ComboBox>
                                    
                                    <ui:Button Icon="{ui:SymbolIcon Settings24}"
                                               Appearance="Secondary"
                                               Margin="12,0,0,0"
                                               ToolTip="Settings"/>
                                </StackPanel>
                            </ui:Card> -->
                
                <!-- Data Table Area -->
                <ui:Card Grid.Row="1" Margin="16,8,16,16" Padding="20" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                                            
                        <!-- Column Headers Component -->
                        <combat:CombatStatsHeader x:Name="StatsHeaderComponent" 
                                                  Grid.Row="1" 
                                                  Margin="0,0,0,4"/>
                    
                        <!-- Data Area -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource StarTrekDarkGray}"
                                BorderBrush="{DynamicResource StarTrekBorderGray}"
                                BorderThickness="1"
                                CornerRadius="4">
                        <Grid>
                                <!-- Empty State -->
                                <StackPanel x:Name="EmptyCombatStatsPanel" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" 
                                            Margin="0,40">
                                    <ui:SymbolIcon Symbol="Table24" 
                                                   FontSize="48" 
                                                   Foreground="{DynamicResource StarTrekBlue}"
                                                   Opacity="0.3"
                                                   Margin="0,0,0,12"/>
                                    <TextBlock Text="Select a combat to view statistics" 
                                               Foreground="{DynamicResource StarTrekTextGray}"
                                               HorizontalAlignment="Center"
                                               Opacity="0.6"/>
                                    <TextBlock Text="Click on a combat from the list above" 
                                               Foreground="{DynamicResource StarTrekTextGray}"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"
                                               FontSize="11"
                                               Opacity="0.5"/>
                                </StackPanel>
                                
                                <!-- Loading Indicator -->
                                <StackPanel x:Name="LoadingCombatStatsPanel" 
                                            Visibility="Collapsed"
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True" 
                                                 Width="200" 
                                                 Height="4"
                                                 Margin="0,0,0,12"/>
                                    <TextBlock x:Name="LoadingCombatStatsText"
                                               Text="Loading combat statistics..." 
                                               Foreground="{DynamicResource StarTrekTextGray}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- Data Table with Expandable Rows -->
                                <ScrollViewer x:Name="CombatStatsScrollViewer"
                                              Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalAlignment="Top">
                                    <ItemsControl x:Name="CombatStatsItemsControl"
                                                  Background="Transparent"
                                                  Padding="8"
                                                  VerticalAlignment="Top">
                                        <!-- Hier wird die Tabelle dynamisch gefüllt -->
                                    </ItemsControl>
                                </ScrollViewer>
                        </Grid>
                    </Border>
                        </Grid>
                        </ui:Card>
                        </Grid>
                    </TabItem>
                    
                    <!-- Tab 2: Live Combat -->
                    <TabItem Header="Live Combat" x:Name="LiveCombatTab" IsEnabled="False">
                        <liveCombat:LiveCombatView x:Name="LiveCombatViewComponent"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
