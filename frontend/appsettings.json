{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "OSCRBackendPath": "OSCRBackend.exe",
  "OSCRSettings": {
    "DefaultMaxCombats": 20,
    "DefaultSecondsBetweenCombats": 45,
    "DefaultCombatMinLines": 20,
    "ProcessTimeoutMinutes": 5
  },
  "LiveCombat": {
    "BindToStoWindow": true,
    "ShowBindingDisclaimer": false
  }
}
