<Page x:Class="StoDamageMeter.Pages.LiveTracking.LiveTrackingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:livetracking="clr-namespace:StoDamageMeter.Components.PageSpecific.LiveTracking"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    Title="Live Tracking">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Padding="24">
        <StackPanel>
            <!-- Live Tracking Card -->
            <livetracking:LiveTrackingCard Margin="0,0,0,24" />

            <!-- Live Damage Statistics Card -->
            <livetracking:LiveDamageStatisticsCard Margin="0,0,0,24" />

            <!-- Real-time Events -->
            <Border Style="{StaticResource StarfleetCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <shared:StarfleetIcon Icon="LiveTracking" Size="20"
                            Color="{StaticResource StarfleetGreen}" Margin="0,0,8,0" />
                        <TextBlock Text="Echtzeit-Events"
                            Style="{StaticResource StarfleetSubtitle}" />

                        <ui:ToggleSwitch IsChecked="{Binding IsWatching}"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center" />
                        <TextBlock Text="Live-Tracking"
                            Style="{StaticResource StarfleetMutedText}"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Events List -->
                    <Border Background="{StaticResource Secondary}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        MinHeight="200"
                        MaxHeight="400">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Name="EventsPanel" Margin="16">
                                <!-- Empty State -->
                                <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,50,0,50">
                                    <shared:StarfleetIcon Icon="LiveTracking" Size="48"
                                        Color="{StaticResource StarfleetSilver}" Margin="0,0,0,16" />
                                    <TextBlock Text="Keine Live-Events"
                                        Style="{StaticResource StarfleetMutedText}"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,8" />
                                    <TextBlock
                                        Text="Starte die Überwachung um Echtzeit-Events zu sehen"
                                        Style="{StaticResource StarfleetMutedText}"
                                        HorizontalAlignment="Center"
                                        FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>