<Page x:Class="StoDamageMeter.Pages.Statistics.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:statistics="clr-namespace:StoDamageMeter.Components.PageSpecific.Statistics"
    xmlns:converters="clr-namespace:StoDamageMeter.Converters"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    Title="Statistics">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <converters:BoolToBadgeVariantConverter x:Key="BoolToBadgeVariantConverter" />
            <converters:TypeToIconConverter x:Key="TypeToIconConverter" />
            <converters:RowIndexConverter x:Key="RowIndexConverter" />
            <converters:CompanionVisibilityConverter x:Key="CompanionVisibilityConverter" />
            <converters:WeaponVisibilityConverter x:Key="WeaponVisibilityConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Padding="24">
            <StackPanel>
                <!-- Spieler-Auswahl -->
                <Border Style="{StaticResource StarfleetCardStyle}"
                    Margin="0,0,0,24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <shared:StarfleetIcon Icon="Users" Size="20"
                                Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                            <TextBlock Text="Spieler-Auswahl"
                                Style="{StaticResource StarfleetTitle}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Spieler:"
                                Style="{StaticResource StarfleetSubtitle}"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0" />
                            <ComboBox ItemsSource="{Binding Statistics.AvailablePlayers}"
                                SelectedItem="{Binding Statistics.SelectedPlayer}"
                                MinWidth="200"
                                Margin="0,0,12,0"
                                Background="{StaticResource Input}"
                                Foreground="{StaticResource Foreground}"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                Padding="12,8"
                                FontSize="14" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Kampf-Auswahl -->
                <Border Style="{StaticResource StarfleetCardStyle}"
                    Margin="0,0,0,24"
                    Visibility="{Binding Statistics.SelectedPlayer, Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <shared:StarfleetIcon Icon="Sword" Size="20"
                                Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                            <TextBlock Text="Kampf-Auswahl"
                                Style="{StaticResource StarfleetTitle}" />
                        </StackPanel>

                        <!-- Kampf-Buttons -->
                        <ItemsControl ItemsSource="{Binding Statistics.CombatPeriods}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Content="{Binding StartTime, StringFormat='{}{0:dd.MM.yyyy | HH:mm}'}"
                                        Command="{Binding DataContext.Statistics.SelectPeriodCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource StarfleetButton}"
                                        Margin="0,0,8,8"
                                        Padding="16,8"
                                        MinWidth="140" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Spieler-Zusammenfassung -->
                <statistics:PlayerSummaryCard DataContext="{Binding Statistics}"
                    Margin="0,0,0,24" />

                <!-- Schadensarten -->
                <statistics:DamageTypeCard
                    DataContext="{Binding Statistics}"
                    Margin="0,0,0,24"
                    Visibility="{Binding Statistics.SelectedPlayer, Converter={StaticResource StringToVisibilityConverter}}" />

                <!-- Waffen-Statistiken -->
                <Border Style="{StaticResource StarfleetCardStyle}"
                    Visibility="{Binding Statistics.SelectedPlayer, Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <shared:StarfleetIcon Icon="Chart" Size="20"
                                Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                            <TextBlock Text="Waffen-Statistiken"
                                Style="{StaticResource StarfleetTitle}" />
                        </StackPanel>

                        <!-- Moderne Tabelle mit Cards -->
                        <ItemsControl ItemsSource="{Binding Statistics.WeaponStatistics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBackground}"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,0,0,12"
                                        Padding="20,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Icon und Name -->
                                            <StackPanel Grid.Column="0" Grid.Row="0"
                                                Orientation="Horizontal" Margin="0,0,16,0">
                                                <shared:StarfleetIcon
                                                    Icon="{Binding Type, Converter={StaticResource TypeToIconConverter}}"
                                                    Size="24"
                                                    Color="{StaticResource StarfleetGold}"
                                                    Margin="0,0,12,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                        Style="{StaticResource StarfleetText}"
                                                        FontSize="16"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource StarfleetGold}" />
                                                    <TextBlock Text="{Binding Type}"
                                                        Style="{StaticResource StarfleetMutedText}"
                                                        FontSize="12" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Schadensanteil Progress Bar -->
                                            <StackPanel Grid.Column="1" Grid.Row="0"
                                                Margin="16,0,16,0">
                                                <TextBlock Text="Schadensanteil"
                                                    Style="{StaticResource StarfleetMutedText}"
                                                    FontSize="12"
                                                    Margin="0,0,0,4" />
                                                <shared:StarfleetProgressBar
                                                    Value="{Binding DamageShare}"
                                                    Text="{Binding DamageShare, StringFormat='{}{0:F1}%'}"
                                                    Height="16" />
                                            </StackPanel>

                                            <!-- DPS -->
                                            <StackPanel Grid.Column="2" Grid.Row="0"
                                                Margin="0,0,16,0">
                                                <TextBlock Text="DPS"
                                                    Style="{StaticResource StarfleetMutedText}"
                                                    FontSize="12"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,4" />
                                                <TextBlock
                                                    Text="{Binding DPS, StringFormat='{}{0:N0}'}"
                                                    Style="{StaticResource StarfleetText}"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource StarfleetRed}"
                                                    FontFamily="Consolas"
                                                    HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Gesamtschaden -->
                                            <StackPanel Grid.Column="3" Grid.Row="0"
                                                Margin="0,0,16,0">
                                                <TextBlock Text="Schaden"
                                                    Style="{StaticResource StarfleetMutedText}"
                                                    FontSize="12"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,4" />
                                                <TextBlock
                                                    Text="{Binding TotalDamage, StringFormat='{}{0:N0}'}"
                                                    Style="{StaticResource StarfleetText}"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource StarfleetGold}"
                                                    FontFamily="Consolas"
                                                    HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Verwendungen -->
                                            <StackPanel Grid.Column="4" Grid.Row="0"
                                                Margin="0,0,16,0">
                                                <TextBlock Text="Verwendungen"
                                                    Style="{StaticResource StarfleetMutedText}"
                                                    FontSize="12"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding TotalUses}"
                                                    Style="{StaticResource StarfleetText}"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource StarfleetSilver}"
                                                    FontFamily="Consolas"
                                                    HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Kritische Rate -->
                                            <StackPanel Grid.Column="5" Grid.Row="0"
                                                Margin="0,0,16,0">
                                                <TextBlock Text="Krit. Rate"
                                                    Style="{StaticResource StarfleetMutedText}"
                                                    FontSize="12"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,4" />
                                                <TextBlock
                                                    Text="{Binding CriticalRate, StringFormat='{}{0:F1}%'}"
                                                    Style="{StaticResource StarfleetText}"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource StarfleetBlue}"
                                                    FontFamily="Consolas"
                                                    HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Ø Schaden -->
                                            <StackPanel Grid.Column="6" Grid.Row="0">
                                                <TextBlock Text="Ø Schaden"
                                                    Style="{StaticResource StarfleetMutedText}"
                                                    FontSize="12"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,4" />
                                                <TextBlock
                                                    Text="{Binding AverageDamage, StringFormat='{}{0:N0}'}"
                                                    Style="{StaticResource StarfleetText}"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource StarfleetGreen}"
                                                    FontFamily="Consolas"
                                                    HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Companion-Waffen (erweiterte Ansicht) -->
                                            <ItemsControl Grid.Column="0" Grid.ColumnSpan="7"
                                                Grid.Row="1"
                                                ItemsSource="{Binding Weapons}"
                                                Margin="40,12,0,0"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Background="{StaticResource DarkBackground}"
                                                            BorderBrush="{StaticResource CardBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Margin="0,0,0,8"
                                                            Padding="16,12">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Waffen-Name -->
                                                                <StackPanel Grid.Column="0"
                                                                    Orientation="Horizontal">
                                                                    <shared:StarfleetIcon
                                                                        Icon="{Binding Type, Converter={StaticResource TypeToIconConverter}}"
                                                                        Size="16"
                                                                        Color="{StaticResource StarfleetSilver}"
                                                                        Margin="0,0,8,0" />
                                                                    <TextBlock Text="{Binding Name}"
                                                                        Style="{StaticResource StarfleetText}"
                                                                        Foreground="{StaticResource StarfleetSilver}" />
                                                                </StackPanel>

                                                                <!-- DPS -->
                                                                <TextBlock Grid.Column="1"
                                                                    Text="{Binding DPS, StringFormat='{}{0:N0}'}"
                                                                    Style="{StaticResource StarfleetText}"
                                                                    FontSize="14"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{StaticResource StarfleetRed}"
                                                                    FontFamily="Consolas"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="0,0,16,0" />

                                                                <!-- Schaden -->
                                                                <TextBlock Grid.Column="2"
                                                                    Text="{Binding TotalDamage, StringFormat='{}{0:N0}'}"
                                                                    Style="{StaticResource StarfleetText}"
                                                                    FontSize="14"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{StaticResource StarfleetGold}"
                                                                    FontFamily="Consolas"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="0,0,16,0" />

                                                                <!-- Verwendungen -->
                                                                <TextBlock Grid.Column="3"
                                                                    Text="{Binding TotalUses}"
                                                                    Style="{StaticResource StarfleetText}"
                                                                    FontSize="14"
                                                                    Foreground="{StaticResource StarfleetSilver}"
                                                                    FontFamily="Consolas"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="0,0,16,0" />

                                                                <!-- Krit. Rate -->
                                                                <TextBlock Grid.Column="4"
                                                                    Text="{Binding CriticalRate, StringFormat='{}{0:F1}%'}"
                                                                    Style="{StaticResource StarfleetText}"
                                                                    FontSize="14"
                                                                    Foreground="{StaticResource StarfleetBlue}"
                                                                    FontFamily="Consolas"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="0,0,16,0" />

                                                                <!-- Ø Schaden -->
                                                                <TextBlock Grid.Column="5"
                                                                    Text="{Binding AverageDamage, StringFormat='{}{0:N0}'}"
                                                                    Style="{StaticResource StarfleetText}"
                                                                    FontSize="14"
                                                                    Foreground="{StaticResource StarfleetGreen}"
                                                                    FontFamily="Consolas"
                                                                    HorizontalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Keine Daten -->
                        <StackPanel HorizontalAlignment="Center"
                            Margin="0,40,0,0"
                            Visibility="{Binding Statistics.WeaponStatistics.Count, Converter={StaticResource NullToVisibilityConverter}}">
                            <shared:StarfleetIcon Icon="Info" Size="32"
                                Color="{StaticResource StarfleetSilver}" />
                            <TextBlock Text="Keine Waffen-Statistiken verfügbar"
                                Style="{StaticResource StarfleetMutedText}"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>