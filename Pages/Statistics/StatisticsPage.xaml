<Page x:Class="StoDamageMeter.Pages.Statistics.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:statistics="clr-namespace:StoDamageMeter.Components.PageSpecific.Statistics"
    xmlns:converters="clr-namespace:StoDamageMeter.Converters"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    Title="Statistics">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <converters:BoolToBadgeVariantConverter x:Key="BoolToBadgeVariantConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Padding="24">
        <StackPanel>
            <!-- Spieler-Auswahl -->
            <Border Style="{StaticResource StarfleetCardStyle}"
                Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <shared:StarfleetIcon Icon="Users" Size="20"
                            Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                        <TextBlock Text="Spieler-Auswahl"
                            Style="{StaticResource StarfleetTitle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Spieler:"
                            Style="{StaticResource StarfleetSubtitle}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />
                        <ComboBox ItemsSource="{Binding Statistics.AvailablePlayers}"
                            SelectedItem="{Binding Statistics.SelectedPlayer}"
                            MinWidth="200"
                            Margin="0,0,12,0"
                            Background="{StaticResource Input}"
                            Foreground="{StaticResource Foreground}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            Padding="12,8"
                            FontSize="14" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Kampf-Auswahl -->
            <Border Style="{StaticResource StarfleetCardStyle}"
                Margin="0,0,0,24"
                Visibility="{Binding Statistics.SelectedPlayer, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <shared:StarfleetIcon Icon="Sword" Size="20"
                            Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                        <TextBlock Text="Kampf-Auswahl"
                            Style="{StaticResource StarfleetTitle}" />
                    </StackPanel>

                    <!-- Kampf-Buttons -->
                    <ItemsControl ItemsSource="{Binding Statistics.CombatPeriods}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Content="{Binding StartTime, StringFormat='{}{0:dd.MM.yyyy | HH:mm}'}"
                                    Command="{Binding DataContext.Statistics.SelectPeriodCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource StarfleetButton}"
                                    Margin="0,0,8,8"
                                    Padding="16,8"
                                    MinWidth="140" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Kampf-Details -->
            <Border Style="{StaticResource StarfleetCardStyle}"
                Margin="0,0,0,24"
                Visibility="{Binding Statistics.SelectedPlayer, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <shared:StarfleetIcon Icon="BarChart" Size="20"
                            Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                        <TextBlock Text="Kampf-Details"
                            Style="{StaticResource StarfleetTitle}" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Dauer -->
                        <StackPanel Grid.Column="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <shared:StarfleetIcon Icon="Clock" Size="14"
                                    Color="{StaticResource StarfleetSilver}" Margin="0,0,4,0" />
                                <TextBlock Text="Dauer"
                                    Style="{StaticResource StarfleetMutedText}" />
                            </StackPanel>
                            <TextBlock
                                Text="{Binding Statistics.SelectedPeriod.Duration, StringFormat='{}{0:mm\\:ss}'}"
                                Style="{StaticResource StarfleetText}"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="{StaticResource StarfleetGold}" />
                        </StackPanel>

                        <!-- Gesamtschaden -->
                        <StackPanel Grid.Column="1" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <shared:StarfleetIcon Icon="Sword" Size="14"
                                    Color="{StaticResource StarfleetSilver}" Margin="0,0,4,0" />
                                <TextBlock Text="Gesamtschaden"
                                    Style="{StaticResource StarfleetMutedText}" />
                            </StackPanel>
                            <TextBlock
                                Text="{Binding Statistics.SelectedPeriod.TotalDamage, StringFormat='{}{0:N0}'}"
                                Style="{StaticResource StarfleetText}"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="{StaticResource StarfleetGold}" />
                        </StackPanel>

                        <!-- DPS -->
                        <StackPanel Grid.Column="2" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <shared:StarfleetIcon Icon="Chart" Size="14"
                                    Color="{StaticResource StarfleetSilver}" Margin="0,0,4,0" />
                                <TextBlock Text="DPS"
                                    Style="{StaticResource StarfleetMutedText}" />
                            </StackPanel>
                            <TextBlock
                                Text="{Binding Statistics.SelectedPeriod.DPS, StringFormat='{}{0:N0}'}"
                                Style="{StaticResource StarfleetText}"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="{StaticResource StarfleetGold}" />
                        </StackPanel>

                        <!-- Einträge -->
                        <StackPanel Grid.Column="3" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <shared:StarfleetIcon Icon="FileText" Size="14"
                                    Color="{StaticResource StarfleetSilver}" Margin="0,0,4,0" />
                                <TextBlock Text="Einträge"
                                    Style="{StaticResource StarfleetMutedText}" />
                            </StackPanel>
                            <TextBlock
                                Text="{Binding Statistics.SelectedPeriod.EntryCount}"
                                Style="{StaticResource StarfleetText}"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="{StaticResource StarfleetGold}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Kampf-Tabelle -->
            <Border Style="{StaticResource StarfleetCardStyle}"
                Visibility="{Binding Statistics.SelectedPlayer, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <shared:StarfleetIcon Icon="Chart" Size="20"
                            Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                        <TextBlock Text="Kampf-Details"
                            Style="{StaticResource StarfleetTitle}" />
                    </StackPanel>

                    <DataGrid
                        ItemsSource="{Binding Statistics.SelectedPeriod.Entries}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="True"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        AlternatingRowBackground="Transparent"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        RowHeaderWidth="0"
                        MaxHeight="400">

                        <!-- Zeitstempel -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zeit"
                                Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}"
                                Width="100" />

                            <!-- Angriff -->
                            <DataGridTextColumn Header="Angriff"
                                Binding="{Binding AttackName}"
                                Width="*" />

                            <!-- Ziel -->
                            <DataGridTextColumn Header="Ziel"
                                Binding="{Binding TargetEntity.Name}"
                                Width="150" />

                            <!-- Schaden -->
                            <DataGridTextColumn Header="Schaden"
                                Binding="{Binding RawDamage, StringFormat='{}{0:N0}'}"
                                Width="100" />

                            <!-- Schadensart -->
                            <DataGridTextColumn Header="Typ"
                                Binding="{Binding DamageType}"
                                Width="100" />

                            <!-- Kritisch -->
                            <DataGridTemplateColumn Header="Kritisch"
                                Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <shared:StarfleetBadge Text="{Binding IsCritical}"
                                            Variant="{Binding IsCritical, Converter={StaticResource BoolToBadgeVariantConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>