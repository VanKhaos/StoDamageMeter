<Page x:Class="StoDamageMeter.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="About">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24">
        <StackPanel>
            <!-- About Card -->
            <ui:CardControl Background="{StaticResource CardBackground}"
                           BorderBrush="{StaticResource CardBorder}"
                           BorderThickness="1"
                           CornerRadius="12"
                           Padding="32"
                           Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <ui:SymbolIcon Symbol="Info24" 
                                      Foreground="{StaticResource PrimaryBlue}"
                                      Width="48" Height="48"
                                      Margin="0,0,24,0"/>
                        <StackPanel>
                            <TextBlock Text="STO Damage Meter" 
                                       Style="{StaticResource ModernSubtitle}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Version 1.0.0" 
                                       Style="{StaticResource ModernSecondaryText}"
                                       FontSize="16"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Ein moderner Combatlog-Analyzer für Star Trek Online" 
                                       Style="{StaticResource ModernMutedText}"
                                       FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <TextBlock Text="Der STO Damage Meter ist ein leistungsstarkes Tool zur Analyse von Combatlog-Daten aus Star Trek Online. Mit moderner Fluent Design UI und Echtzeit-Tracking bietet er detaillierte Einblicke in deine Kampfleistung." 
                               Style="{StaticResource ModernSecondaryText}"
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Margin="0,0,0,24"/>
                    
                    <!-- Features Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left Column -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="DataUsage24" 
                                              Foreground="{StaticResource SuccessGreen}"
                                              Width="20" Height="20"
                                              Margin="0,0,12,0"/>
                                <TextBlock Text="Echtzeit-Tracking" 
                                           Style="{StaticResource ModernText}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="ChartMultiple24" 
                                              Foreground="{StaticResource PrimaryBlue}"
                                              Width="20" Height="20"
                                              Margin="0,0,12,0"/>
                                <TextBlock Text="Detaillierte Statistiken" 
                                           Style="{StaticResource ModernText}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="Target24" 
                                              Foreground="{StaticResource WarningOrange}"
                                              Width="20" Height="20"
                                              Margin="0,0,12,0"/>
                                <TextBlock Text="DPS-Analyse" 
                                           Style="{StaticResource ModernText}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Right Column -->
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="Settings24" 
                                              Foreground="{StaticResource AccentBlue}"
                                              Width="20" Height="20"
                                              Margin="0,0,12,0"/>
                                <TextBlock Text="Anpassbare Einstellungen" 
                                           Style="{StaticResource ModernText}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="Export24" 
                                              Foreground="{StaticResource SuccessGreen}"
                                              Width="20" Height="20"
                                              Margin="0,0,12,0"/>
                                <TextBlock Text="Datenexport" 
                                           Style="{StaticResource ModernText}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="DarkTheme24" 
                                              Foreground="{StaticResource TextMuted}"
                                              Width="20" Height="20"
                                              Margin="0,0,12,0"/>
                                <TextBlock Text="Dark Theme" 
                                           Style="{StaticResource ModernText}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:CardControl>
            
            <!-- Technology Stack -->
            <ui:CardControl Background="{StaticResource CardBackground}"
                           BorderBrush="{StaticResource CardBorder}"
                           BorderThickness="1"
                           CornerRadius="12"
                           Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="Code24" 
                                      Foreground="{StaticResource AccentBlue}"
                                      Width="24" Height="24"
                                      Margin="0,0,12,0"/>
                        <TextBlock Text="Technologie-Stack" 
                                   Style="{StaticResource ModernSubtitle}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left Column -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="• WPF (.NET 9.0)" 
                                       Style="{StaticResource ModernSecondaryText}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="• WPF UI Framework" 
                                       Style="{StaticResource ModernSecondaryText}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="• MVVM Pattern" 
                                       Style="{StaticResource ModernSecondaryText}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="• Fluent Design System" 
                                       Style="{StaticResource ModernSecondaryText}"
                                       Margin="0,0,0,4"/>
                        </StackPanel>
                        
                        <!-- Right Column -->
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="• Dependency Injection" 
                                       Style="{StaticResource ModernSecondaryText}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="• Async/Await Pattern" 
                                       Style="{StaticResource ModernSecondaryText}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="• File System Watching" 
                                       Style="{StaticResource ModernSecondaryText}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="• JSON Serialization" 
                                       Style="{StaticResource ModernSecondaryText}"
                                       Margin="0,0,0,4"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
