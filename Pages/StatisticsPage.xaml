<Page x:Class="StoDamageMeter.Pages.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:components="clr-namespace:StoDamageMeter.Components"
      Title="Statistics">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24">
        <StackPanel>
            <!-- Statistics Overview Card -->
            <components:StatisticsOverviewCard Margin="0,0,0,24"/>
            
            <!-- Detailed Statistics Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Damage by Type -->
                <ui:CardControl Grid.Column="0" 
                               Background="{StaticResource CardBackground}"
                               BorderBrush="{StaticResource CardBorder}"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="24"
                               Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="ChartMultiple24" 
                                          Foreground="{StaticResource WarningOrange}"
                                          Width="24" Height="24"
                                          Margin="0,0,12,0"/>
                            <TextBlock Text="Schaden nach Typ" 
                                       Style="{StaticResource ModernSubtitle}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        
                        <!-- Damage Types List -->
                        <ItemsControl ItemsSource="{Binding Statistics.DamageByType}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Key}" 
                                                   Style="{StaticResource ModernSecondaryText}"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Value, StringFormat={}{0:N0}}" 
                                                   Style="{StaticResource ModernText}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessGreen}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Empty State -->
                        <StackPanel HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Margin="0,20,0,0"
                                   Visibility="{Binding Statistics.DamageByType, Converter={StaticResource NullToVisibilityConverter}}">
                            <ui:SymbolIcon Symbol="ChartMultiple24" 
                                          Foreground="{StaticResource TextMuted}"
                                          Width="32" Height="32"
                                          Margin="0,0,0,8"/>
                            <TextBlock Text="Keine Daten" 
                                       Style="{StaticResource ModernMutedText}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl>
                
                <!-- Top Attacks -->
                <ui:CardControl Grid.Column="1" 
                               Background="{StaticResource CardBackground}"
                               BorderBrush="{StaticResource CardBorder}"
                               BorderThickness="1"
                               CornerRadius="12"
                               Padding="24"
                               Margin="12,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="Target24" 
                                          Foreground="{StaticResource PrimaryBlue}"
                                          Width="24" Height="24"
                                          Margin="0,0,12,0"/>
                            <TextBlock Text="Top Angriffe" 
                                       Style="{StaticResource ModernSubtitle}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        
                        <!-- Top Attacks List -->
                        <ItemsControl ItemsSource="{Binding Statistics.DamageByAttack}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Key}" 
                                                   Style="{StaticResource ModernSecondaryText}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Value, StringFormat={}{0:N0}}" 
                                                   Style="{StaticResource ModernText}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBlue}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- Empty State -->
                        <StackPanel HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Margin="0,20,0,0"
                                   Visibility="{Binding Statistics.DamageByAttack, Converter={StaticResource NullToVisibilityConverter}}">
                            <ui:SymbolIcon Symbol="Target24" 
                                          Foreground="{StaticResource TextMuted}"
                                          Width="32" Height="32"
                                          Margin="0,0,0,8"/>
                            <TextBlock Text="Keine Daten" 
                                       Style="{StaticResource ModernMutedText}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
