<Page x:Class="StoDamageMeter.Pages.About.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    Title="About">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Padding="24">
        <StackPanel>
            <!-- About Card -->
            <Border Style="{StaticResource StarfleetCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <shared:StarfleetIcon Icon="About" Size="24"
                            Color="{StaticResource StarfleetGold}" Margin="0,0,12,0" />
                        <TextBlock Text="StoDamageMeter"
                            Style="{StaticResource StarfleetTitle}" />
                    </StackPanel>

                    <TextBlock Text="Ein moderner Damage Meter für Star Trek Online"
                        Style="{StaticResource StarfleetSubtitle}"
                        Margin="0,0,0,24" />

                    <!-- App Info -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Version -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <shared:StarfleetIcon Icon="Info" Size="14"
                                    Color="{StaticResource StarfleetSilver}" Margin="0,0,4,0" />
                                <TextBlock Text="Version"
                                    Style="{StaticResource StarfleetMutedText}" />
                            </StackPanel>
                            <TextBlock Text="1.0.0"
                                Style="{StaticResource StarfleetText}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{StaticResource StarfleetGold}" />
                        </StackPanel>

                        <!-- Build -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <shared:StarfleetIcon Icon="Settings" Size="14"
                                    Color="{StaticResource StarfleetSilver}" Margin="0,0,4,0" />
                                <TextBlock Text="Build"
                                    Style="{StaticResource StarfleetMutedText}" />
                            </StackPanel>
                            <TextBlock Text="2025.01"
                                Style="{StaticResource StarfleetText}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{StaticResource StarfleetGold}" />
                        </StackPanel>

                        <!-- Framework -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <shared:StarfleetIcon Icon="Star" Size="14"
                                    Color="{StaticResource StarfleetSilver}" Margin="0,0,4,0" />
                                <TextBlock Text="Framework"
                                    Style="{StaticResource StarfleetMutedText}" />
                            </StackPanel>
                            <TextBlock Text=".NET 9.0 WPF"
                                Style="{StaticResource StarfleetText}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{StaticResource StarfleetGold}" />
                        </StackPanel>

                        <!-- Theme -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <shared:StarfleetIcon Icon="Star" Size="14"
                                    Color="{StaticResource StarfleetSilver}" Margin="0,0,4,0" />
                                <TextBlock Text="Theme"
                                    Style="{StaticResource StarfleetMutedText}" />
                            </StackPanel>
                            <TextBlock Text="Star Trek"
                                Style="{StaticResource StarfleetText}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{StaticResource StarfleetGold}" />
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <Border Background="{StaticResource Secondary}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,24">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <shared:StarfleetIcon Icon="Info" Size="16"
                                    Color="{StaticResource StarfleetSilver}" Margin="0,0,8,0" />
                                <TextBlock Text="Über diese Anwendung"
                                    Style="{StaticResource StarfleetText}"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock
                                Text="StoDamageMeter ist eine moderne WPF-Anwendung zur Analyse von Star Trek Online Combat Logs. Die App bietet Echtzeit-Tracking, detaillierte Statistiken und ein benutzerfreundliches Star Trek Theme."
                                Style="{StaticResource StarfleetMutedText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Features -->
                    <Border Background="{StaticResource Secondary}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <shared:StarfleetIcon Icon="Star" Size="16"
                                    Color="{StaticResource StarfleetSilver}" Margin="0,0,8,0" />
                                <TextBlock Text="Features"
                                    Style="{StaticResource StarfleetText}"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <shared:StarfleetIcon Icon="CheckCircle" Size="14"
                                        Color="{StaticResource StarfleetGreen}" Margin="0,0,8,0" />
                                    <TextBlock Text="Echtzeit Combat Log Überwachung"
                                        Style="{StaticResource StarfleetMutedText}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <shared:StarfleetIcon Icon="CheckCircle" Size="14"
                                        Color="{StaticResource StarfleetGreen}" Margin="0,0,8,0" />
                                    <TextBlock Text="Detaillierte Damage Statistiken"
                                        Style="{StaticResource StarfleetMutedText}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <shared:StarfleetIcon Icon="CheckCircle" Size="14"
                                        Color="{StaticResource StarfleetGreen}" Margin="0,0,8,0" />
                                    <TextBlock Text="Player-spezifische Kampf-Analyse"
                                        Style="{StaticResource StarfleetMutedText}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <shared:StarfleetIcon Icon="CheckCircle" Size="14"
                                        Color="{StaticResource StarfleetGreen}" Margin="0,0,8,0" />
                                    <TextBlock Text="Modernes Star Trek Design"
                                        Style="{StaticResource StarfleetMutedText}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>