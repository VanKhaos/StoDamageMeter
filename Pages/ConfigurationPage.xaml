<Page x:Class="StoDamageMeter.Pages.ConfigurationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:components="clr-namespace:StoDamageMeter.Components"
      Title="Configuration">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24">
        <StackPanel>
            <!-- Configuration Card -->
            <components:ConfigurationCard Margin="0,0,0,24"/>
            
            <!-- Advanced Settings -->
            <ui:CardControl Background="{StaticResource CardBackground}"
                           BorderBrush="{StaticResource CardBorder}"
                           BorderThickness="1"
                           CornerRadius="12"
                           Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <ui:SymbolIcon Symbol="Settings24" 
                                      Foreground="{StaticResource AccentBlue}"
                                      Width="24" Height="24"
                                      Margin="0,0,12,0"/>
                        <TextBlock Text="Erweiterte Einstellungen" 
                                   Style="{StaticResource ModernSubtitle}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <!-- Settings Grid -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Auto-Refresh Setting -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Auto-Refresh" 
                                           Style="{StaticResource ModernText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Automatische Aktualisierung der Statistiken" 
                                           Style="{StaticResource ModernMutedText}"
                                           FontSize="12"/>
                            </StackPanel>
                            
                            <ui:ToggleSwitch Grid.Column="1" 
                                            IsChecked="True"
                                            VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Update Interval -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Update-Intervall" 
                                           Style="{StaticResource ModernText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Zeit zwischen den Aktualisierungen" 
                                           Style="{StaticResource ModernMutedText}"
                                           FontSize="12"/>
                            </StackPanel>
                            
                            <ui:NumberBox Grid.Column="1" 
                                         Value="1000"
                                         Minimum="100"
                                         Maximum="10000"
                                         Width="120"
                                         VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Debug Mode -->
                        <Grid Grid.Row="2" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Debug-Modus" 
                                           Style="{StaticResource ModernText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Detaillierte Logs für Entwicklung" 
                                           Style="{StaticResource ModernMutedText}"
                                           FontSize="12"/>
                            </StackPanel>
                            
                            <ui:ToggleSwitch Grid.Column="1" 
                                            IsChecked="False"
                                            VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Export Settings -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Export-Format" 
                                           Style="{StaticResource ModernText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Standardformat für Datenexport" 
                                           Style="{StaticResource ModernMutedText}"
                                           FontSize="12"/>
                            </StackPanel>
                            
                            <ComboBox Grid.Column="1" 
                                      SelectedIndex="0"
                                      Width="120"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="JSON"/>
                                <ComboBoxItem Content="CSV"/>
                                <ComboBoxItem Content="XML"/>
                            </ComboBox>
                        </Grid>
                    </Grid>
                </StackPanel>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
