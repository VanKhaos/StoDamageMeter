<Page x:Class="StoDamageMeter.Pages.CustomStyles.CustomStylesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:customStyles="clr-namespace:StoDamageMeter.Components.PageSpecific.Statistics"
    Title="Custom Styles Examples">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource StarfleetCardStyle}" Margin="20,20,20,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:SymbolIcon Symbol="Color24"
                        FontSize="24"
                        Foreground="{StaticResource StarfleetGold}"
                        Margin="0,0,12,0" />
                    <TextBlock Text="Custom Styles Examples"
                        Style="{StaticResource StarfleetTitle}" />
                </StackPanel>
                <TextBlock
                    Text="Beispiele für benutzerdefinierte DataGrid-Styles und Anleitung zur Erstellung eigener Styles"
                    Style="{StaticResource StarfleetSubtitle}" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto"
            Margin="20,0,20,20">
            <customStyles:CustomStylesExampleCard />
        </ScrollViewer>
    </Grid>
</Page>