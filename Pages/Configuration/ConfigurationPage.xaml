<Page x:Class="StoDamageMeter.Pages.Configuration.ConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:configuration="clr-namespace:StoDamageMeter.Components.PageSpecific.Configuration"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    Title="Configuration">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Padding="24">
        <StackPanel>
            <!-- Configuration Card -->
            <configuration:ConfigurationCard Margin="0,0,0,24" />

            <!-- Advanced Settings -->
            <Border Style="{StaticResource StarfleetCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <shared:StarfleetIcon Icon="Settings" Size="20"
                            Color="{StaticResource StarfleetGold}" Margin="0,0,8,0" />
                        <TextBlock Text="Erweiterte Einstellungen"
                            Style="{StaticResource StarfleetSubtitle}" />
                    </StackPanel>

                    <!-- Settings Grid -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Auto-Refresh Setting -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Auto-Refresh"
                                    Style="{StaticResource ModernText}"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,4" />
                                <TextBlock Text="Automatische Aktualisierung der Statistiken"
                                    Style="{StaticResource ModernMutedText}"
                                    FontSize="12" />
                            </StackPanel>

                            <ui:ToggleSwitch Grid.Column="1"
                                IsChecked="True"
                                VerticalAlignment="Center" />
                        </Grid>

                        <!-- Update Interval -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Update-Intervall"
                                    Style="{StaticResource ModernText}"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,4" />
                                <TextBlock Text="Zeit zwischen den Aktualisierungen"
                                    Style="{StaticResource ModernMutedText}"
                                    FontSize="12" />
                            </StackPanel>

                            <ui:NumberBox Grid.Column="1"
                                Value="1000"
                                Minimum="100"
                                Maximum="10000"
                                Width="120"
                                VerticalAlignment="Center" />
                        </Grid>

                        <!-- Debug Mode -->
                        <Grid Grid.Row="2" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Debug-Modus"
                                    Style="{StaticResource ModernText}"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,4" />
                                <TextBlock Text="Detaillierte Logs für Entwicklung"
                                    Style="{StaticResource ModernMutedText}"
                                    FontSize="12" />
                            </StackPanel>

                            <ui:ToggleSwitch Grid.Column="1"
                                IsChecked="False"
                                VerticalAlignment="Center" />
                        </Grid>

                        <!-- Export Settings -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Export-Format"
                                    Style="{StaticResource ModernText}"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,4" />
                                <TextBlock Text="Standardformat für Datenexport"
                                    Style="{StaticResource ModernMutedText}"
                                    FontSize="12" />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                SelectedIndex="0"
                                Width="120"
                                VerticalAlignment="Center">
                                <ComboBoxItem Content="JSON" />
                                <ComboBoxItem Content="CSV" />
                                <ComboBoxItem Content="XML" />
                            </ComboBox>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>