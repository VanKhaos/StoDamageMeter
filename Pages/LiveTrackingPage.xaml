<Page x:Class="StoDamageMeter.Pages.LiveTrackingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:components="clr-namespace:StoDamageMeter.Components"
      Title="Live Tracking">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24">
        <StackPanel>
            <!-- Live Tracking Card -->
            <components:LiveTrackingCard Margin="0,0,0,24"/>
            
            <!-- Live Damage Statistics Card -->
            <components:LiveDamageStatisticsCard Margin="0,0,0,24"/>
            
            <!-- Real-time Events -->
            <ui:CardControl Background="{StaticResource CardBackground}"
                           BorderBrush="{StaticResource CardBorder}"
                           BorderThickness="1"
                           CornerRadius="12"
                           Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="DataUsage24" 
                                      Foreground="{StaticResource SuccessGreen}"
                                      Width="24" Height="24"
                                      Margin="0,0,12,0"/>
                        <TextBlock Text="Echtzeit-Events" 
                                   Style="{StaticResource ModernSubtitle}"
                                   FontWeight="SemiBold"/>
                        
                        <ui:ToggleSwitch IsChecked="{Binding IsWatching}"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"/>
                        <TextBlock Text="Live-Tracking" 
                                   Style="{StaticResource ModernSecondaryText}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Events List -->
                    <Border Background="{StaticResource DarkBackground}"
                            BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            MinHeight="200"
                            MaxHeight="400">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Name="EventsPanel" Margin="16">
                                <!-- Empty State -->
                                <StackPanel HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           Margin="0,50,0,50">
                                    <ui:SymbolIcon Symbol="DataUsage24" 
                                                  Foreground="{StaticResource TextMuted}"
                                                  Width="48" Height="48"
                                                  Margin="0,0,0,16"/>
                                    <TextBlock Text="Keine Live-Events" 
                                               Style="{StaticResource ModernSecondaryText}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Starte die Überwachung um Echtzeit-Events zu sehen" 
                                               Style="{StaticResource ModernMutedText}"
                                               HorizontalAlignment="Center"
                                               FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
