<Page x:Class="StoDamageMeter.Pages.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:shared="clr-namespace:StoDamageMeter.Components.Shared"
    xmlns:dashboard="clr-namespace:StoDamageMeter.Components.PageSpecific.Dashboard"
    Title="Dashboard">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Padding="24">
        <StackPanel>
            <!-- File Selection Card -->
            <dashboard:FileSelectionCard Margin="0,0,0,16" />

            <!-- Player Table Card -->
            <dashboard:PlayerTableCard Margin="0,0,0,24" />
        </StackPanel>
    </ScrollViewer>
</Page>