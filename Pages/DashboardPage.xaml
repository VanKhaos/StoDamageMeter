<Page x:Class="StoDamageMeter.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:components="clr-namespace:StoDamageMeter.Components"
    Title="Dashboard">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Padding="24">
        <StackPanel>

            <!-- Quick Actions Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- File Selection Card -->
                <components:FileSelectionCard Grid.Column="0"
                    Margin="0,0,12,0" />

            </Grid>

            <!-- Loading Spinner -->
            <components:LoadingSpinner Margin="0,0,0,24" />

            <!-- Combatlog Info Card -->
            <components:CombatLogInfoCard Margin="0,0,0,24" />

        </StackPanel>
    </ScrollViewer>
</Page>